import kotlin.time.Instant;

CREATE TABLE history(
    id INTEGER NOT NULL PRIMARY KEY,
    manga_id INTEGER NOT NULL,
    chapter_id INTEGER NOT NULL UNIQUE,
    read_at INTEGER AS Instant,
    read_duration INTEGER NOT NULL,
    -- KUN -->
    -- Retired by 67.sqm: the tombstone queue is `pending_history_deletion`. SQLite cannot drop a
    -- column at the app's minimum version and both views over this table block a rebuild, so these
    -- stay unwritten and unread.
    pending_deletion INTEGER NOT NULL DEFAULT 0,
    removed_at_ms INTEGER NOT NULL DEFAULT 0,
    -- KUN <--
    FOREIGN KEY(manga_id) REFERENCES manga (id)
    ON DELETE CASCADE,
    FOREIGN KEY(chapter_id) REFERENCES chapter (id)
    ON DELETE CASCADE
);

CREATE INDEX history_manga_id_index ON history(manga_id);
CREATE INDEX history_read_at_index ON history(read_at);

-- KUN -->
-- The SyncYomi `history` tombstones this device still owes the server. The queue is its own table,
-- keyed by the parts of the server's key and holding no foreign key, so that the removal outlives
-- the row: a library prune, a manga delete or a source dropping a chapter must not drop a queued
-- tombstone, or the deletion never reaches the server.
--
-- 0 is "unknown": the removal happened before this build recorded the time. Sent as `at` in Unix
-- seconds, for the server to compare with the entry's own `modified_at`.
CREATE TABLE pending_history_deletion(
    id INTEGER NOT NULL PRIMARY KEY,
    source_id INTEGER NOT NULL,
    manga_url TEXT NOT NULL,
    chapter_url TEXT NOT NULL,
    removed_at_ms INTEGER NOT NULL,
    UNIQUE(source_id, manga_url, chapter_url)
);
-- KUN <--

getHistoryByMangaId:
SELECT id, chapter_id, read_at, read_duration
FROM history
WHERE manga_id = :mangaId;

getHistoryByMangaIds:
SELECT manga_id, id, chapter_id, read_at, read_duration
FROM history
WHERE manga_id IN :mangaIds
ORDER BY manga_id, id;

-- KUN -->
-- The rows a full-snapshot sync compares against the server's history lists, each with the chapter
-- url its tombstone key is built from: one projection instead of every chapter of every manga.
getHistoryChapterEntriesByMangaIds:
SELECT history.manga_id, history.id, chapter.remote_url, history.read_at
FROM history
JOIN chapter ON chapter.id = history.chapter_id
WHERE history.manga_id IN :mangaIds
ORDER BY history.manga_id, history.id;
-- KUN <--

-- KUN -->
-- Copy the entries of a removal into the queue before their rows are reset: the urls are what the
-- server keys a history entry by, so they have to be read while the row still knows its chapter.
--
-- `:removedAtMs` is 0 when the removal will not be sent, so no time reference outlives its marker.
--
-- OR IGNORE, not a refresh: the rows are unique by source, manga and chapter url, and a row that is
-- still queued has no read date left to remove a second time.
queuePendingHistoryDeletionsByIds:
INSERT OR IGNORE INTO pending_history_deletion(source_id, manga_url, chapter_url, removed_at_ms)
SELECT manga.source_id, manga.remote_url, chapter.remote_url, :removedAtMs
FROM history
JOIN chapter ON chapter.id = history.chapter_id
JOIN manga ON manga.id = history.manga_id
WHERE history.id IN :historyIds AND history.read_at IS NOT NULL;

queuePendingHistoryDeletionsByMangaIds:
INSERT OR IGNORE INTO pending_history_deletion(source_id, manga_url, chapter_url, removed_at_ms)
SELECT manga.source_id, manga.remote_url, chapter.remote_url, :removedAtMs
FROM history
JOIN chapter ON chapter.id = history.chapter_id
JOIN manga ON manga.id = history.manga_id
WHERE history.manga_id IN :mangaIds AND history.read_at IS NOT NULL;

queueAllPendingHistoryDeletions:
INSERT OR IGNORE INTO pending_history_deletion(source_id, manga_url, chapter_url, removed_at_ms)
SELECT manga.source_id, manga.remote_url, chapter.remote_url, :removedAtMs
FROM history
JOIN chapter ON chapter.id = history.chapter_id
JOIN manga ON manga.id = history.manga_id
WHERE history.read_at IS NOT NULL;

-- Paged by the queue row id: a page is a range scan from the cursor instead of a scan of the whole
-- table, and "clear all history" can queue a whole library.
getPendingHistoryDeletions:
SELECT id, source_id, manga_url, chapter_url, removed_at_ms
FROM pending_history_deletion
WHERE id > :afterId
ORDER BY id
LIMIT :limit;

-- The server confirmed these tombstones, so their queue rows go: nothing is left to restore or to
-- send again. The removal itself stands, and its history row stays reset.
clearPendingHistoryDeletion:
DELETE FROM pending_history_deletion
WHERE id IN :ids;

-- Drop every marker a configuration change stranded (history sync turned off, another service
-- selected, a host that is no longer v2): no request will ever send them.
clearAllPendingHistoryDeletions:
DELETE FROM pending_history_deletion;

-- A real read supersedes a removal the server has not been told about yet: the queued tombstone is
-- dropped instead of being sent over the new read. The key is derived from the chapter row and
-- matched as a whole, so the lookup is the queue's unique index instead of a scan of a queue that
-- "clear all history" can fill with a whole library.
deletePendingHistoryDeletionByChapterId:
DELETE FROM pending_history_deletion
WHERE (source_id, manga_url, chapter_url) IN (
    SELECT manga.source_id, manga.remote_url, chapter.remote_url
    FROM chapter
    JOIN manga ON manga.id = chapter.manga_id
    WHERE chapter.id = :chapterId
);

-- Whether a removal of that chapter is still queued: a restore's insert branch refuses a payload read
-- over it for the same reason `setHistoryFromRestore` does, so the answer comes from the same key.
countPendingHistoryDeletionsByChapterId:
SELECT count(*)
FROM pending_history_deletion
WHERE (source_id, manga_url, chapter_url) IN (
    SELECT manga.source_id, manga.remote_url, chapter.remote_url
    FROM chapter
    JOIN manga ON manga.id = chapter.manga_id
    WHERE chapter.id = :chapterId
);
-- KUN <--

-- KMK -->
-- Removed unused SY query getHistoryByChapterUrlAndMangaId
-- KMK <--

-- KUN -->
-- A removal is a soft delete: the row loses its read date, which is what every history reader shows
-- as gone. What the server still owes is queued separately, so nothing here depends on the row
-- surviving.
removeHistoryByIds:
UPDATE history
SET read_at = NULL
WHERE id IN :historyIds AND read_at IS NOT NULL;

removeHistoryByMangaIds:
UPDATE history
SET read_at = NULL
WHERE manga_id IN :mangaIds AND read_at IS NOT NULL;
-- KUN <--

-- KMK -->
resetHistoryByIds:
UPDATE history
SET read_at = NULL
WHERE id IN :historyIds;

resetHistoryByMangaIds:
UPDATE history
SET read_at = NULL
WHERE manga_id IN :mangaIds;
-- KMK <--

-- KUN -->
-- "Clear all history" is a soft delete like the other two removal paths: every row that still has a
-- read date is reset, and its tombstone queued, so the removal reaches the server.
--
-- The rows stay, so `getReadDuration` keeps counting the time the user spent reading them, exactly
-- as a per-entry removal already did: the stat is "time read", not "time read on entries the
-- History tab still lists".
removeAllHistory:
UPDATE history
SET read_at = NULL
WHERE read_at IS NOT NULL;
-- KUN <--

-- KUN -->
-- "Clear database" drops every row a removal reset. The queue is a table of its own, so a reset row
-- may go even while its tombstone is still queued.
removeResettedHistory:
DELETE FROM history
WHERE read_at IS NULL;
-- KUN <--

upsert:
INSERT INTO history(manga_id, chapter_id, read_at, read_duration)
SELECT manga_id, id, :readAt, :readDuration
FROM chapter
WHERE id = :chapterId
-- KUN -->
ON CONFLICT(chapter_id) DO UPDATE SET
    read_at = max(coalesce(history.read_at, 0), coalesce(excluded.read_at, 0)),
    read_duration = read_duration + excluded.read_duration;
-- KUN <--

-- KUN -->
-- Exact history write for a restore that owns the row: the payload decides read_at (NULL means
-- the entry was removed) while read_duration never moves backwards. Matched on chapter_id, never
-- on the history row id.
--
-- A queued removal is left alone: the user removed it here and the server has not been told yet, so
-- a payload read (or its own tombstone) must not resurrect it. Its time is not compared here: the
-- server decides, through the tombstone's own `at`. An inbound history tombstone carries that `at`
-- in whole seconds, so it applies only to a row whose read lands in that second or earlier; a read
-- in a later second keeps the row.
setHistoryFromRestore:
UPDATE history
SET read_at = :readAt,
    read_duration = max(read_duration, :readDuration)
WHERE chapter_id = :chapterId
AND NOT EXISTS (
    SELECT 1
    FROM chapter
    JOIN manga ON manga.id = chapter.manga_id
    JOIN pending_history_deletion
    ON pending_history_deletion.source_id = manga.source_id
    AND pending_history_deletion.manga_url = manga.remote_url
    AND pending_history_deletion.chapter_url = chapter.remote_url
    WHERE chapter.id = :chapterId
);
-- KUN <--

getReadDuration:
SELECT coalesce(sum(read_duration), 0)
FROM history;
