import java.util.Date;

CREATE TABLE history(
    id INTEGER NOT NULL PRIMARY KEY,
    manga_id INTEGER NOT NULL,
    chapter_id INTEGER NOT NULL UNIQUE,
    read_at INTEGER AS Date,
    read_duration INTEGER NOT NULL,
    FOREIGN KEY(manga_id) REFERENCES manga (id)
    ON DELETE CASCADE,
    FOREIGN KEY(chapter_id) REFERENCES chapter (id)
    ON DELETE CASCADE
);

CREATE INDEX history_manga_id_index ON history(manga_id);
CREATE INDEX history_read_at_index ON history(read_at);

-- KMK -->
CREATE TRIGGER history_update_manga_id_after_chapter_move
AFTER UPDATE OF manga_id ON chapter
WHEN old.manga_id IS NOT new.manga_id
BEGIN
    UPDATE history SET manga_id = new.manga_id WHERE chapter_id = new.id;
END;
-- KMK <--

getHistoryByMangaId:
SELECT id, chapter_id, read_at, read_duration
FROM history
WHERE manga_id = :mangaId;

getHistoryByChapterUrl:
SELECT
H.id,
H.chapter_id,
H.read_at,
H.read_duration
FROM history H
JOIN chapter C
ON H.chapter_id = C.id
WHERE C.remote_url = :chapterUrl AND C.manga_id = :mangaId
LIMIT 1;

-- KMK -->
resetHistoryByIds:
-- KMK <--
UPDATE history
SET read_at = 0
WHERE id IN :historyIds;

resetHistoryByMangaIds:
-- KMK <--
UPDATE history
SET read_at = 0
WHERE manga_id IN :mangaIds;

removeAllHistory:
DELETE FROM history;

removeResettedHistory:
DELETE FROM history
WHERE read_at = 0;

upsert:
INSERT INTO history(manga_id, chapter_id, read_at, read_duration)
SELECT manga_id, id, :readAt, :readDuration
FROM chapter
WHERE id = :chapterId
ON CONFLICT(chapter_id) DO UPDATE SET
    read_at = excluded.read_at,
    read_duration = read_duration + excluded.read_duration;

getReadDuration:
SELECT coalesce(sum(read_duration), 0)
FROM history;
