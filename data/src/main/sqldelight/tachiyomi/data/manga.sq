-- KMK <--

insertNetworkManga {
    -- A new entry is inserted as the source reported it. An existing one takes the fresh details
    -- only while it is outside the library, so a library entry keeps what the user already has.
    INSERT INTO manga(
        source_id, remote_url, remote_title, remote_author, remote_artist, remote_description,
        remote_genre, remote_status, remote_cover, remote_update_strategy, remote_memo,
        user_favorite_at, user_notes, user_reader_flags, user_chapter_flags, user_filtered_scanlators,
        state_chapter_last_update, state_chapter_next_update, state_chapter_fetch_interval,
        state_cover_last_modified, state_initialized, state_date_added, state_last_modified_at,
        state_version, state_is_syncing
    )
    VALUES (
        :sourceId, :remoteUrl, :remoteTitle, :remoteAuthor, :remoteArtist, :remoteDescription,
        :remoteGenre, :remoteStatus, :remoteCover, :remoteUpdateStrategy, :remoteMemo,
        CASE WHEN :favorite THEN :stateDateAdded ELSE NULL END, :userNotes,
        :userReaderFlags, :userChapterFlags, :userFilteredScanlators,
        :stateChapterLastUpdate, :stateChapterNextUpdate, :stateChapterFetchInterval,
        :stateCoverLastModified, :stateInitialized, :stateDateAdded, 0, :stateVersion, 0
    )
    ON CONFLICT(source_id, remote_url) DO UPDATE SET
        remote_title = CASE WHEN :updateTitle THEN excluded.remote_title ELSE remote_title END,
        remote_cover = CASE WHEN :updateCover THEN excluded.remote_cover ELSE remote_cover END,
        remote_author = CASE WHEN :updateDetails THEN excluded.remote_author ELSE remote_author END,
        remote_artist = CASE WHEN :updateDetails THEN excluded.remote_artist ELSE remote_artist END,
        remote_description = CASE WHEN :updateDetails THEN excluded.remote_description ELSE remote_description END,
        remote_genre = CASE WHEN :updateDetails THEN excluded.remote_genre ELSE remote_genre END,
        remote_status = CASE WHEN :updateDetails THEN excluded.remote_status ELSE remote_status END,
        remote_update_strategy = CASE
            WHEN :updateDetails THEN excluded.remote_update_strategy
            ELSE remote_update_strategy
        END,
        remote_memo = excluded.remote_memo,
        state_initialized = :updateDetails
    WHERE user_favorite_at IS NULL
    -- KMK -->
    AND :updateInfo;
    -- KMK <--

    SELECT
        id, source_id, remote_url, remote_title, remote_author, remote_artist, remote_description,
        remote_genre, remote_status, remote_cover, remote_update_strategy, remote_memo,
        user_favorite_at, user_notes, user_reader_flags, user_chapter_flags,
        user_filtered_scanlators,
        state_chapter_last_update, state_chapter_next_update, state_chapter_fetch_interval,
        state_cover_last_modified, state_initialized, state_date_added, state_last_modified_at,
        state_version, state_is_syncing
    FROM manga
    WHERE source_id = :sourceId
    AND remote_url = :remoteUrl;
}

getEhMangaWithMetadata:
SELECT
    manga.id, manga.source_id, manga.remote_url, manga.remote_title, manga.remote_author,
    manga.remote_artist, manga.remote_description, manga.remote_genre, manga.remote_status,
    manga.remote_cover, manga.remote_update_strategy, manga.remote_memo,
    manga.user_favorite_at, manga.user_notes, manga.user_reader_flags,
    manga.user_chapter_flags, manga.user_filtered_scanlators,
    manga.state_chapter_last_update, manga.state_chapter_next_update,
    manga.state_chapter_fetch_interval, manga.state_cover_last_modified,
    manga.state_initialized, manga.state_date_added, manga.state_last_modified_at,
    manga.state_version, manga.state_is_syncing
FROM manga
INNER JOIN search_metadata
    ON manga.id = search_metadata.manga_id
WHERE manga.user_favorite_at IS NOT NULL AND (manga.source_id = :eh OR manga.source_id = :exh);

getIdsOfFavoriteMangaWithMetadata:
SELECT manga.id FROM manga
INNER JOIN search_metadata
    ON manga.id = search_metadata.manga_id
WHERE manga.user_favorite_at IS NOT NULL;

