-- KMK <--


insertNetworkManga {
    -- Insert the manga if it doesn't exist already
    INSERT INTO manga(
        source_id, remote_url, remote_artist, remote_author, remote_description, remote_genre, remote_title, remote_status, remote_cover, user_favorite_at,
        state_chapter_last_update, state_chapter_next_update, state_initialized, user_reader_flags, user_chapter_flags, state_cover_last_modified, state_date_added,
        remote_update_strategy, state_chapter_fetch_interval, state_last_modified_at, state_version, remote_memo
    )
    SELECT
        :source, :url, :artist, :author, :description, :genre, :title, :status, :thumbnailUrl, CASE WHEN :favorite THEN :dateAdded ELSE NULL END,
        :lastUpdate, :nextUpdate, :initialized, :viewerFlags, :chapterFlags, :coverLastModified, :dateAdded,
        :updateStrategy, :calculateInterval, 0, :version, :memo
    WHERE NOT EXISTS(SELECT 0 FROM manga WHERE source_id = :source AND remote_url = :url);

    -- Update the relevant details if applicable and not favorite
    UPDATE manga
    SET
        remote_title = CASE WHEN :updateTitle THEN :title ELSE remote_title END,
        remote_cover = CASE WHEN :updateCover THEN :thumbnailUrl ELSE remote_cover END,
        remote_author = CASE WHEN :updateDetails THEN :author ELSE remote_author END,
        remote_artist = CASE WHEN :updateDetails THEN :artist ELSE remote_artist END,
        remote_description = CASE WHEN :updateDetails THEN :description ELSE remote_description END,
        remote_genre = CASE WHEN :updateDetails THEN :genre ELSE remote_genre END,
        remote_status = CASE WHEN :updateDetails THEN :status ELSE remote_status END,
        remote_update_strategy = CASE WHEN :updateDetails THEN :updateStrategy ELSE remote_update_strategy END,
        state_initialized = :updateDetails,
        remote_memo = :memo
    WHERE source_id = :source
    -- KMK -->
    AND :updateInfo
    -- KMK <--
    AND remote_url = :url
    AND user_favorite_at IS NULL;

    -- Finally return the manga
    SELECT *
    FROM manga
    WHERE source_id = :source
    AND remote_url = :url
    LIMIT 1;
}

getEhMangaWithMetadata:
SELECT manga.* FROM manga
INNER JOIN search_metadata
    ON manga.id = search_metadata.manga_id
WHERE manga.user_favorite_at IS NOT NULL AND (manga.source_id = :eh OR manga.source_id = :exh);

getIdsOfFavoriteMangaWithMetadata:
SELECT manga.id FROM manga
INNER JOIN search_metadata
    ON manga.id = search_metadata.manga_id
WHERE manga.user_favorite_at IS NOT NULL;

getBySource:
SELECT * FROM manga WHERE source_id = :sourceId;

getAll:
SELECT * FROM manga;

deleteById:
DELETE FROM manga WHERE id = :id;


getIdByUrlAndSource:
SELECT id
FROM manga
WHERE remote_url = :url AND source_id = :source;
