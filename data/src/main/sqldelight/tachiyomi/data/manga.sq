import eu.kanade.tachiyomi.source.model.UpdateStrategy;
import kotlin.Boolean;
import kotlin.String;
import kotlin.collections.List;
import kotlinx.serialization.json.JsonObject;

CREATE TABLE manga(
    id INTEGER NOT NULL PRIMARY KEY,
    source_id INTEGER NOT NULL,
    remote_url TEXT NOT NULL,
    remote_artist TEXT,
    remote_author TEXT,
    remote_description TEXT,
    remote_genre TEXT AS List<String>,
    remote_title TEXT NOT NULL,
    remote_status INTEGER NOT NULL,
    remote_cover TEXT,
    user_favorite_at INTEGER,
    state_chapter_last_update INTEGER,
    state_chapter_next_update INTEGER,
    state_initialized INTEGER AS Boolean NOT NULL,
    user_reader_flags INTEGER NOT NULL,
    user_chapter_flags INTEGER NOT NULL,
    state_cover_last_modified INTEGER NOT NULL,
    -- KMK -->
    state_date_added INTEGER NOT NULL,
    user_filtered_scanlators TEXT,
    -- KMK <--
    remote_update_strategy INTEGER AS UpdateStrategy NOT NULL DEFAULT 0,
    state_chapter_fetch_interval INTEGER DEFAULT 0 NOT NULL,
    -- KMK -->
    state_last_modified_at INTEGER NOT NULL DEFAULT 0,
    state_version INTEGER NOT NULL DEFAULT 0,
    state_is_syncing INTEGER NOT NULL DEFAULT 0,
    -- KMK <--
    user_notes TEXT NOT NULL DEFAULT "",
    remote_memo BLOB AS JsonObject NOT NULL DEFAULT (CAST('{}' AS BLOB)),
    UNIQUE(source_id, remote_url)
);

CREATE INDEX manga_user_favorite_at_index ON manga(user_favorite_at) WHERE user_favorite_at IS NOT NULL;

-- KMK -->
CREATE TRIGGER update_last_modified_at_mangas
AFTER UPDATE ON manga
FOR EACH ROW
BEGIN
  UPDATE manga
  SET state_last_modified_at = strftime('%s', 'now')
  WHERE id = new.id;
END;

CREATE TRIGGER update_manga_version AFTER UPDATE ON manga
BEGIN
    UPDATE manga SET state_version = state_version + 1
    WHERE id = new.id AND new.state_is_syncing = 0 AND (
        new.remote_url != old.remote_url OR
        new.remote_description != old.remote_description OR
        new.user_favorite_at IS NOT old.user_favorite_at
    );
END;
-- KMK <--

getMangaById:
SELECT *
FROM manga
WHERE id = :id;

-- TODO: this should ideally never really have more than 1 result
getMangaByUrlAndSource:
SELECT *
FROM manga
WHERE remote_url = :url
AND source_id = :source
LIMIT 1;

getFavorites:
SELECT *
FROM manga
WHERE user_favorite_at IS NOT NULL;

getReadMangaNotInLibrary:
SELECT *
FROM manga
WHERE user_favorite_at IS NULL AND id IN (
    SELECT DISTINCT chapter.manga_id
    FROM chapter
    WHERE user_read = 1 OR user_last_page_read != 0
);

getAllManga:
SELECT *
FROM manga;

getAllMangaSourceAndUrl:
SELECT source_id AS source, remote_url AS url
FROM manga;

getMangasWithFavoriteTimestamp:
SELECT *
FROM manga
WHERE user_favorite_at IS NOT NULL;

getSourceIdWithFavoriteCount:
SELECT
source_id AS source,
count(*)
FROM manga
WHERE user_favorite_at IS NOT NULL
GROUP BY source_id;

getFavoriteBySourceId:
SELECT *
FROM manga
WHERE user_favorite_at IS NOT NULL
AND source_id = :sourceId;

getDuplicateLibraryManga:
WITH
track_dupes AS (
    SELECT DISTINCT S2.manga_id
    FROM manga_track S1
    INNER JOIN manga_track S2
    ON S1.tracker_id = S2.tracker_id
    AND S1.remote_id = S2.remote_id
    AND S1.manga_id != S2.manga_id
    WHERE S1.manga_id = :id
),
duplicates AS (
    SELECT M.*
    FROM manga M
    LEFT JOIN track_dupes D
    ON D.manga_id = id
    WHERE user_favorite_at IS NOT NULL
    AND id != :id
    AND (lower(remote_title) LIKE '%' || lower(:title) || '%' OR D.manga_id IS NOT NULL)
),
chapter_counts AS (
    SELECT
        M.id AS manga_id,
        count(*) AS chapter_count
    FROM duplicates M
    JOIN chapter C
    ON M.id = C.manga_id
    LEFT JOIN excluded_scanlator ES
    ON C.manga_id = ES.manga_id
    AND C.remote_scanlator = ES.scanlator
    WHERE ES.scanlator IS NULL
    GROUP BY M.id
)
SELECT
    M.*,
    coalesce(CC.chapter_count, 0) AS chapter_count
FROM duplicates M
LEFT JOIN chapter_counts CC
ON M.id = CC.manga_id;

getUpcomingManga:
SELECT *
FROM manga
WHERE state_chapter_next_update >= :startOfDay
AND user_favorite_at IS NOT NULL
AND remote_status IN :statuses
ORDER BY state_chapter_next_update ASC;

resetViewerFlags:
UPDATE manga
SET user_reader_flags = 0;

resetIsSyncing:
UPDATE manga
SET state_is_syncing = 0
WHERE state_is_syncing = 1;

-- KMK -->
updateLibraryChapterFlags:
UPDATE manga
SET user_chapter_flags = :chapterFlags
WHERE user_favorite_at IS NOT NULL;
-- KMK <--

getSourceIdsWithNonLibraryManga:
SELECT source_id, COUNT(*) AS manga_count
FROM manga
WHERE user_favorite_at IS NULL
GROUP BY source_id;

deleteNonLibraryManga:
DELETE FROM manga
WHERE user_favorite_at IS NULL
AND source_id IN :sourceIds
AND (
    :keepReadManga = 0
    OR id NOT IN (
        SELECT DISTINCT manga_id
        FROM chapter
        WHERE user_read = 1
        OR user_last_page_read != 0
    )
) AND id NOT IN (
     SELECT DISTINCT manga_id FROM merged WHERE manga_id != merge_id
);

insert:
INSERT INTO manga(source_id, remote_url, remote_artist, remote_author, remote_description, remote_genre, remote_title, remote_status, remote_cover, user_favorite_at, state_chapter_last_update, state_chapter_next_update, state_initialized, user_reader_flags, user_chapter_flags, state_cover_last_modified, state_date_added, remote_update_strategy, state_chapter_fetch_interval, state_last_modified_at, state_version, user_notes, remote_memo)
VALUES (:source, :url, :artist, :author, :description, :genre, :title, :status, :thumbnailUrl, CASE WHEN :favorite THEN :dateAdded ELSE NULL END, :lastUpdate, :nextUpdate, :initialized, :viewerFlags, :chapterFlags, :coverLastModified, :dateAdded, :updateStrategy, :calculateInterval, 0, :version, :notes, :memo);

-- KMK -->
insertReturningId:
INSERT INTO manga(source_id, remote_url, remote_artist, remote_author, remote_description, remote_genre, remote_title, remote_status, remote_cover, user_favorite_at, state_chapter_last_update, state_chapter_next_update, state_initialized, user_reader_flags, user_chapter_flags, state_cover_last_modified, state_date_added, remote_update_strategy, state_chapter_fetch_interval, state_last_modified_at, state_version, user_notes, remote_memo)
VALUES (:source, :url, :artist, :author, :description, :genre, :title, :status, :thumbnailUrl, CASE WHEN :favorite THEN :dateAdded ELSE NULL END, :lastUpdate, :nextUpdate, :initialized, :viewerFlags, :chapterFlags, :coverLastModified, :dateAdded, :updateStrategy, :calculateInterval, 0, :version, :notes, :memo)
RETURNING id;
-- KMK <--

update:
UPDATE manga SET
    source_id = coalesce(:source, source_id),
    remote_url = coalesce(:url, remote_url),
    remote_artist = coalesce(:artist, remote_artist),
    remote_author = coalesce(:author, remote_author),
    remote_description = coalesce(:description, remote_description),
    remote_genre = coalesce(:genre, remote_genre),
    remote_title = coalesce(:title, remote_title),
    remote_status = coalesce(:status, remote_status),
    remote_cover = coalesce(:thumbnailUrl, remote_cover),
    user_favorite_at = CASE
        WHEN :favorite IS NULL THEN user_favorite_at
        WHEN :favorite THEN coalesce(user_favorite_at, strftime('%s', 'now'))
        ELSE NULL
    END,
    state_chapter_last_update = coalesce(:lastUpdate, state_chapter_last_update),
    state_chapter_next_update = coalesce(:nextUpdate, state_chapter_next_update),
    state_initialized = coalesce(:initialized, state_initialized),
    user_reader_flags = coalesce(:viewer, user_reader_flags),
    user_chapter_flags = coalesce(:chapterFlags, user_chapter_flags),
    state_cover_last_modified = coalesce(:coverLastModified, state_cover_last_modified),
    state_date_added = coalesce(:dateAdded, state_date_added),
    remote_update_strategy = coalesce(:updateStrategy, remote_update_strategy),
    state_chapter_fetch_interval = coalesce(:calculateInterval, state_chapter_fetch_interval),
    state_version = coalesce(:version, state_version),
    state_is_syncing = coalesce(:isSyncing, state_is_syncing),
    user_notes = coalesce(:notes, user_notes),
    remote_memo = coalesce(:memo, remote_memo)
WHERE id = :mangaId;

-- KMK -->
updateRemote:
UPDATE manga SET
    remote_artist = coalesce(:artist, remote_artist),
    remote_author = coalesce(:author, remote_author),
    remote_description = coalesce(:description, remote_description),
    remote_genre = coalesce(:genre, remote_genre),
    remote_title = coalesce(:title, remote_title),
    remote_status = :status,
    remote_cover = coalesce(:thumbnailUrl, remote_cover),
    state_initialized = :initialized,
    state_cover_last_modified = coalesce(:coverLastModified, state_cover_last_modified),
    remote_update_strategy = :updateStrategy,
    remote_memo = :memo
WHERE id = :mangaId;
-- KMK <--

