CREATE TABLE source(
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    language TEXT NOT NULL
);

findAll:
SELECT id, language, name
FROM source;

findOne:
SELECT id, language, name
FROM source
WHERE id = :id;

upsert:
INSERT INTO source(id, name, language)
VALUES (:id, :name, :lang)
ON CONFLICT(id)
DO UPDATE
SET
    name = :name,
    language = :lang
WHERE id = :id;
