import kotlin.Boolean;
import kotlin.Int;
import kotlin.time.Instant;
import kotlinx.serialization.json.JsonObject;

CREATE TABLE chapter(
    id INTEGER NOT NULL PRIMARY KEY,
    manga_id INTEGER NOT NULL,
    remote_url TEXT NOT NULL,
    remote_name TEXT NOT NULL,
    remote_scanlator TEXT,
    remote_chapter_number REAL NOT NULL,
    remote_date_upload INTEGER AS Instant,
    remote_order INTEGER NOT NULL,
    remote_memo BLOB AS JsonObject NOT NULL,
    user_read INTEGER AS Boolean NOT NULL,
    user_bookmark INTEGER AS Boolean NOT NULL,
    user_last_page_read INTEGER AS Int NOT NULL,
    state_date_fetch INTEGER AS Instant NOT NULL,
    -- SY -->
    last_modified_at INTEGER NOT NULL DEFAULT 0,
    version INTEGER NOT NULL DEFAULT 0,
    is_syncing INTEGER NOT NULL DEFAULT 0,
    -- SY <--
    -- KNS -->
    user_bookmark_color INTEGER NOT NULL DEFAULT 0,
    -- KNS <--
    UNIQUE(manga_id, remote_url),
    FOREIGN KEY(manga_id) REFERENCES manga (id)
    ON DELETE CASCADE
);

CREATE INDEX chapter_state_date_fetch_index ON chapter(state_date_fetch);
CREATE INDEX chapter_unread_state_date_fetch_index ON chapter(state_date_fetch) WHERE user_read = 0;

-- SY -->
CREATE TRIGGER update_last_modified_at_chapters
AFTER UPDATE ON chapter
FOR EACH ROW
-- KUN -->
WHEN new.is_syncing = 0 AND old.is_syncing = 0 AND new.last_modified_at IS old.last_modified_at
-- KUN <--
BEGIN
  UPDATE chapter
  SET last_modified_at = strftime('%s', 'now')
  WHERE id = new.id;
END;

-- Chapters are versioned and merged separately in sync protocol v2; bumping the manga version per
-- chapter read let the device that read more chapters win all manga-level merges.
CREATE TRIGGER update_chapter_and_manga_version AFTER UPDATE ON chapter
WHEN new.is_syncing = 0 AND (
    new.user_read != old.user_read OR
    new.user_bookmark != old.user_bookmark OR
    new.user_last_page_read != old.user_last_page_read
    -- KNS -->
    OR new.user_bookmark_color != old.user_bookmark_color
    -- KNS <--
)
BEGIN
    UPDATE chapter SET version = version + 1
    WHERE id = new.id;
END;
-- SY <--

getChapterById:
SELECT
    id, manga_id, remote_url, remote_name, remote_scanlator, remote_chapter_number,
    remote_date_upload, remote_order, remote_memo, user_read, user_bookmark,
    user_last_page_read, state_date_fetch, last_modified_at, version, is_syncing,
    -- KNS -->
    user_bookmark_color
    -- KNS <--
FROM chapter
WHERE id = :id;

getChaptersByMangaId:
SELECT
    C.id, C.manga_id, C.remote_url, C.remote_name, C.remote_scanlator, C.remote_chapter_number,
    C.remote_date_upload, C.remote_order, C.remote_memo, C.user_read, C.user_bookmark,
    C.user_last_page_read, C.state_date_fetch, C.last_modified_at, C.version, C.is_syncing,
    -- KNS -->
    C.user_bookmark_color
    -- KNS <--
FROM chapter C
-- KMK -->
JOIN manga M ON C.manga_id = M.id
-- KMK <--
LEFT JOIN excluded_scanlator ES
ON C.manga_id = ES.manga_id
AND C.remote_scanlator = ES.scanlator
WHERE C.manga_id = :mangaId
AND (
    :applyFilter = 0
    -- KMK -->
    OR (
        ES.scanlator IS NULL
        AND ((M.user_chapter_flags & :bookmarkUnmask) = 0 OR C.user_bookmark = 0)
        AND ((M.user_chapter_flags & :bookmarkMask) = 0 OR C.user_bookmark = 1)
    )
    -- KMK <--
);

getChapterSummaryByMangaId:
SELECT count(*) AS total, max(remote_chapter_number) AS latestChapterNumber
FROM chapter
WHERE manga_id = :mangaId;

getScanlatorsByMangaId:
SELECT DISTINCT remote_scanlator
FROM chapter
WHERE manga_id = :mangaId;

getBookmarkedChaptersByMangaId:
SELECT
    id, manga_id, remote_url, remote_name, remote_scanlator, remote_chapter_number,
    remote_date_upload, remote_order, remote_memo, user_read, user_bookmark,
    user_last_page_read, state_date_fetch, last_modified_at, version, is_syncing,
    -- KNS -->
    user_bookmark_color
    -- KNS <--
FROM chapter
WHERE manga_id = :mangaId
AND user_bookmark;

-- SY -->
getChapterByUrl:
SELECT
    id, manga_id, remote_url, remote_name, remote_scanlator, remote_chapter_number,
    remote_date_upload, remote_order, remote_memo, user_read, user_bookmark,
    user_last_page_read, state_date_fetch, last_modified_at, version, is_syncing,
    -- KNS -->
    user_bookmark_color
    -- KNS <--
FROM chapter
WHERE remote_url = :chapterUrl;
-- SY <--

getChapterByUrlAndMangaId:
SELECT
    id, manga_id, remote_url, remote_name, remote_scanlator, remote_chapter_number,
    remote_date_upload, remote_order, remote_memo, user_read, user_bookmark,
    user_last_page_read, state_date_fetch, last_modified_at, version, is_syncing,
    -- KNS -->
    user_bookmark_color
    -- KNS <--
FROM chapter
WHERE manga_id = :mangaId
AND remote_url = :remoteUrl
LIMIT 1;

-- SY -->
-- Returns the chapters a merged entry shows, deduped per its sort mode
-- (MergedMangaReference.CHAPTER_SORT_*).
-- KUN -->
-- The fork's sort-mode numbering differs from upstream's (PRIORITY is 1, not 2), and the bookmark
-- flags filter is kept.
-- KUN <--
getDedupedMergedChapters:
WITH refs AS (
    SELECT manga_id, chapter_priority
    FROM merged
    WHERE merge_id = :mangaId
),
base AS (
    SELECT
        C.id, C.manga_id, C.remote_url, C.remote_name, C.remote_scanlator,
        C.remote_chapter_number, C.remote_date_upload, C.remote_order, C.remote_memo,
        C.user_read, C.user_bookmark, C.user_last_page_read, C.state_date_fetch,
        C.last_modified_at, C.version, C.is_syncing,
        -- KNS -->
        C.user_bookmark_color,
        -- KNS <--
        R.chapter_priority
    FROM chapter C
    JOIN refs R
    ON R.manga_id = C.manga_id
    -- KNS --> a merge's excluded scanlators are stored on the merge entry itself, as before
    LEFT JOIN excluded_scanlator ES
    ON ES.manga_id = :mangaId
    AND C.remote_scanlator = ES.scanlator
    -- KNS <--
    -- KMK -->
    JOIN manga MA ON MA.id = :mangaId
    -- KMK <--
    WHERE (
        :applyFilter = 0
        -- KMK -->
        OR (
            ES.scanlator IS NULL
            AND ((MA.user_chapter_flags & :bookmarkUnmask) = 0 OR C.user_bookmark = 0)
            AND ((MA.user_chapter_flags & :bookmarkMask) = 0 OR C.user_bookmark = 1)
        )
        -- KMK <--
    )
)
SELECT
    B.id, B.manga_id, B.remote_url, B.remote_name, B.remote_scanlator,
    B.remote_chapter_number, B.remote_date_upload, B.remote_order, B.remote_memo,
    B.user_read, B.user_bookmark, B.user_last_page_read, B.state_date_fetch,
    B.last_modified_at, B.version, B.is_syncing,
    -- KNS -->
    B.user_bookmark_color
    -- KNS <--
FROM base B
WHERE :sortMode = 0
OR (:sortMode = 1 AND (
    B.remote_chapter_number < 0
    OR NOT EXISTS (
        SELECT 1
        FROM base B2
        WHERE B2.remote_chapter_number = B.remote_chapter_number
        AND B2.manga_id != B.manga_id
        AND (
            B2.chapter_priority < B.chapter_priority
            OR (B2.chapter_priority = B.chapter_priority AND B2.manga_id < B.manga_id)
        )
    )
))
OR (:sortMode = 2 AND B.manga_id = (
    SELECT B2.manga_id
    FROM base B2
    GROUP BY B2.manga_id
    ORDER BY COUNT(*) DESC, B2.manga_id
    LIMIT 1
))
OR (:sortMode = 3 AND B.manga_id = (
    SELECT B2.manga_id
    FROM base B2
    WHERE B2.remote_chapter_number >= 0
    GROUP BY B2.manga_id
    ORDER BY MAX(B2.remote_chapter_number) DESC, B2.manga_id
    LIMIT 1
))
-- chapter_priority first so PRIORITY mode comes back interleaved by source priority
ORDER BY B.chapter_priority, B.manga_id, B.remote_order;

getScanlatorsByMergeId:
SELECT DISTINCT remote_scanlator
FROM (
    SELECT manga_id FROM merged WHERE merge_id = ?
) AS M
JOIN chapter
ON chapter.manga_id = M.manga_id;
-- SY <--

-- KNS -->
-- The bookmark colors used by each manga's bookmarked chapters; a merged entry also gets its
-- members' colors. Feeds the library's bookmark-color filter.
getBookmarkColorsByManga:
SELECT manga_id, user_bookmark_color
FROM chapter
WHERE user_bookmark
UNION
SELECT M.merge_id, C.user_bookmark_color
FROM merged M
JOIN chapter C ON C.manga_id = M.manga_id
WHERE C.user_bookmark;
-- KNS <--

removeChaptersWithIds:
DELETE FROM chapter
WHERE id IN :chapterIds;

-- SY -->
-- KUN -->
-- One-shot force push: mirror the manga bump for the chapters of every library entry.
-- `last_modified_at` only moves forward so a chapter read while the upload was in flight is still
-- picked up by the next delta.
forcePushVersions:
UPDATE chapter
SET version = max(version, :version),
    last_modified_at = max(last_modified_at, :lastModifiedAt)
WHERE manga_id IN (
    SELECT id FROM manga
    WHERE favorite_modified_at IS NOT NULL OR user_favorite_at IS NOT NULL
);
-- KUN <--

resetIsSyncing:
UPDATE chapter
SET is_syncing = 0
WHERE is_syncing = 1;
-- SY <--

insert:
INSERT INTO chapter(
    manga_id, remote_url, remote_name, remote_scanlator, remote_chapter_number,
    remote_date_upload, remote_order, remote_memo, user_read, user_bookmark,
    user_last_page_read, state_date_fetch, last_modified_at, version, is_syncing,
    -- KNS -->
    user_bookmark_color
    -- KNS <--
)
VALUES (
    :mangaId, :remoteUrl, :remoteName, :remoteScanlator, :remoteChapterNumber,
    :remoteDateUpload, :remoteOrder, :remoteMemo, :userRead, :userBookmark,
    :userLastPageRead, :stateDateFetch,
    -- KUN -->
    -- A sync restore inserts the payload's authoritative value, so its chapters must not look edited
    -- now: that would make the next delta re-upload the whole restored library. Every other insert
    -- (a library update's new chapters, and a manual backup restore, whose entries are local content
    -- from now on) gets a timestamp when the caller has none.
    CASE WHEN :lastModifiedAt = 0 AND :isSyncing = 0 THEN strftime('%s', 'now') ELSE :lastModifiedAt END,
    -- KUN <--
    :version, :isSyncing,
    -- KNS -->
    :userBookmarkColor
    -- KNS <--
)
-- Two syncs of the same entry can race; the chapter the other one already stored is skipped rather
-- than failing the whole batch
ON CONFLICT(manga_id, remote_url) DO NOTHING
RETURNING id;

update:
UPDATE chapter
SET user_read = coalesce(:read, user_read),
    user_bookmark = coalesce(:bookmark, user_bookmark),
    -- KNS -->
    user_bookmark_color = coalesce(:bookmarkColor, user_bookmark_color),
    -- KNS <--
    user_last_page_read = coalesce(:lastPageRead, user_last_page_read),
    state_date_fetch = coalesce(:dateFetch, state_date_fetch),
    -- SY -->
    version = coalesce(:version, version),
    last_modified_at = coalesce(:lastModifiedAt, last_modified_at),
    is_syncing = coalesce(:isSyncing, is_syncing)
    -- SY <--
WHERE id = :chapterId;

updateRemote:
UPDATE chapter
SET remote_name = :name,
    remote_scanlator = coalesce(:scanlator, remote_scanlator),
    remote_chapter_number = :chapterNumber,
    remote_order = :sourceOrder,
    remote_date_upload = coalesce(:dateUpload, remote_date_upload),
    remote_memo = :memo
WHERE id = :chapterId;

updateFromBackup:
UPDATE chapter
SET user_read = coalesce(:read, user_read),
    user_bookmark = coalesce(:bookmark, user_bookmark),
    -- KNS -->
    user_bookmark_color = coalesce(:bookmarkColor, user_bookmark_color),
    -- KNS <--
    user_last_page_read = coalesce(:lastPageRead, user_last_page_read),
    remote_order = coalesce(:sourceOrder, remote_order),
    remote_date_upload = coalesce(:dateUpload, remote_date_upload),
    -- KUN -->
    -- An existing chapter URL kept the metadata it was inserted with, so a restore only refreshed
    -- new URLs. Name/number/scanlator follow the merged chapter: on a sync restore that is the
    -- incoming copy when it wins on version/timestamp, and an explicit null must clear a stale
    -- scanlator. dateFetch is gated instead: an ordinary restore of an older backup must not move
    -- the Updates feed chronology backwards, so the caller passes it only for sync restores.
    remote_name = :name,
    remote_scanlator = :scanlator,
    remote_chapter_number = :chapterNumber,
    state_date_fetch = coalesce(:dateFetch, state_date_fetch),
    -- KUN <--
    -- SY -->
    version = coalesce(:version, version),
    last_modified_at = coalesce(:lastModifiedAt, last_modified_at),
    is_syncing = coalesce(:isSyncing, is_syncing),
    -- SY <--
    remote_memo = coalesce(:memo, remote_memo)
WHERE id = :chapterId;
