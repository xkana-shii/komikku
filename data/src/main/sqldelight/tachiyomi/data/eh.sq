deleteBySyncId:
DELETE FROM manga_track WHERE tracker_id = :syncId;

migrateSource:
UPDATE manga
SET source_id = :newId
WHERE source_id = :oldId;

-- KMK -->
migrateMergedSource:
UPDATE merged
SET manga_source = :newId
WHERE manga_source = :oldId;

migrateSourceSavedSearch:
UPDATE saved_search
SET source = :newId
WHERE source = :oldId;

migrateSourceFeed:
UPDATE feed_saved_search
SET source = :newId
WHERE source = :oldId;
-- KMK <--

getChaptersByMangaIds:
SELECT
    id, manga_id, remote_url, remote_name, remote_scanlator, user_read, user_bookmark,
    user_bookmark_color, user_last_page_read, remote_chapter_number, remote_order,
    state_date_fetch, remote_date_upload, state_last_modified_at, state_version,
    state_is_syncing, remote_memo
FROM chapter
WHERE manga_id IN :mangaIds;

migrateAllNhentaiToOtherLang:
UPDATE manga
SET source_id = :nh
WHERE user_favorite_at IS NOT NULL AND source_id IN :sources;

resetReaderViewerForAllManga:
UPDATE manga
SET user_reader_flags = 0;

fixReaderViewerBackupBug:
UPDATE manga
SET user_reader_flags = 0
WHERE user_reader_flags = -1;

addAllMangaInDatabaseToLibrary:
UPDATE manga
SET user_favorite_at = coalesce(user_favorite_at, strftime('%s', 'now'));
