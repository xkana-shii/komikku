deleteBySyncId:
DELETE FROM manga_track WHERE tracker_id = :syncId;

migrateSource:
UPDATE manga
SET source_id = :newId
WHERE source_id = :oldId;

-- KMK -->
-- KUN -->
-- No `migrateMergedSource`: a merge entry now stores the child's manga id, so the `migrateSource`
-- update above already moves it to the new source id (the entry follows its manga row).
-- KUN <--
migrateSourceSavedSearch:
UPDATE saved_search
SET source = :newId
WHERE source = :oldId;

migrateSourceFeed:
UPDATE feed_saved_search
SET source = :newId
WHERE source = :oldId;
-- KMK <--

getChaptersByMangaIds:
SELECT * FROM chapter WHERE manga_id IN :mangaIds;

migrateAllNhentaiToOtherLang:
UPDATE manga
SET source_id = :nh
WHERE user_favorite_at IS NOT NULL AND source_id IN :sources;

resetReaderViewerForAllManga:
UPDATE manga
SET user_reader_flags = 0;

fixReaderViewerBackupBug:
UPDATE manga
SET user_reader_flags = 0
WHERE user_reader_flags = -1;

addAllMangaInDatabaseToLibrary:
UPDATE manga
SET user_favorite_at = CAST(strftime('%s', 'now') AS INTEGER) * 1000
WHERE user_favorite_at IS NULL;
