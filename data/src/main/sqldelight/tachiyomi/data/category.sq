import kotlin.Long;
import kotlin.collections.List;

CREATE TABLE category(
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    `order` INTEGER NOT NULL UNIQUE,
    flags INTEGER NOT NULL,
    manga_order TEXT AS List<Long> NOT NULL,
    -- KMK -->
    hidden INTEGER DEFAULT 0 NOT NULL
    -- KMK <--
);

-- Insert system category
INSERT OR IGNORE INTO category(id, name, `order`, flags, manga_order, hidden) VALUES (0, "", -1, 0, "", 0);
-- Disallow deletion of default category
CREATE TRIGGER IF NOT EXISTS system_category_delete_trigger BEFORE DELETE
ON category
BEGIN SELECT CASE
    WHEN old.id <= 0 THEN
        RAISE(ABORT, "System category can't be deleted")
    END;
END;

getCategory:
SELECT id,name,`order`,flags,hidden
FROM category
WHERE id = :id;

getCategories:
SELECT
id AS id,
name,
`order`,
flags,
-- KMK -->
hidden
-- KMK <--
FROM category
ORDER BY `order`;

getCategoriesByMangaId:
SELECT
C.id AS id,
C.name,
C.`order`,
C.flags,
-- KMK -->
C.hidden
-- KMK <--
FROM category C
JOIN manga_category MC
ON C.id = MC.category_id
WHERE MC.manga_id = :mangaId
ORDER BY C.`order`;

insert:
INSERT INTO category(name, `order`, flags, manga_order, hidden)
VALUES (:name, :order, :flags, "", :hidden);

-- KMK -->
insertReturningId:
INSERT INTO category(name, `order`, flags, manga_order, hidden)
VALUES (:name, :order, :flags, "", :hidden)
RETURNING id;
-- KMK <--

delete:
DELETE FROM category
WHERE id = :id;

updateName:
UPDATE category
SET name = :name
WHERE id = :id;

getUserCategoryIds:
SELECT id
FROM category
WHERE id > 0
ORDER BY `order`;

updateOrder:
UPDATE category
SET `order` = :order
WHERE id = :id;

updateFlags:
UPDATE category
SET flags = :flags
WHERE id = :id;

-- KMK -->
updateNameAndOrder:
UPDATE category
SET name = :name, `order` = :order
WHERE id = :categoryId;

updateHidden:
UPDATE category
SET hidden = :hidden
WHERE id = :categoryId;
-- KMK <--

updateAllFlags:
UPDATE category
SET flags = :flags;
