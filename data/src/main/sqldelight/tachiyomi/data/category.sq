import kotlin.Long;
import kotlin.collections.List;

CREATE TABLE category(
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    `order` INTEGER NOT NULL UNIQUE,
    flags INTEGER NOT NULL,
    -- KMK -->
    hidden INTEGER NOT NULL DEFAULT 0,
    -- KMK <--
    -- SY -->
    version INTEGER NOT NULL DEFAULT 0,
    uid INTEGER NOT NULL DEFAULT 0,
    last_modified_at INTEGER NOT NULL DEFAULT 0,
    is_syncing INTEGER NOT NULL DEFAULT 0,
    -- SY <--
    -- KNS -->
    parent_id INTEGER NOT NULL DEFAULT 0,
    track_status INTEGER,
    update_interval INTEGER,
    date_added INTEGER NOT NULL DEFAULT 0,
    date_modified INTEGER NOT NULL DEFAULT 0
    -- KNS <--
);

-- KNS -->
CREATE INDEX category_parent_id_index ON category(parent_id);
-- KNS <--

-- Insert system category
INSERT OR IGNORE INTO category(id, name, `order`, flags, hidden, version, uid, last_modified_at, is_syncing) VALUES (0, "", -1, 0, 0, 0, 0, 0, 0);
-- Disallow deletion of default category
CREATE TRIGGER IF NOT EXISTS system_category_delete_trigger BEFORE DELETE
ON category
BEGIN SELECT CASE
    WHEN old.id <= 0 THEN
        RAISE(ABORT, "System category can't be deleted")
    END;
END;

-- SY -->
CREATE TRIGGER update_category_version AFTER UPDATE ON category
WHEN new.is_syncing = 0 AND (
    new.name != old.name OR
    new.`order` != old.`order` OR
    new.flags != old.flags
    -- KUN -->
    OR new.hidden != old.hidden
    -- KUN <--
    -- KNS -->
    OR new.parent_id != old.parent_id
    OR new.track_status IS NOT old.track_status
    OR new.update_interval IS NOT old.update_interval
    -- KNS <--
)
BEGIN
    UPDATE category
    SET version = version + 1,
        last_modified_at = strftime('%s', 'now')
    WHERE id = new.id;
END;

CREATE TRIGGER insert_category_uid AFTER INSERT ON category
-- KUN --> a sync restore inserts with is_syncing = 1; it must keep the backup's last_modified_at
WHEN new.is_syncing = 0
-- KUN <--
BEGIN
    UPDATE category
    SET uid = CASE WHEN uid = 0 THEN abs(random()) ELSE uid END,
        last_modified_at = CASE WHEN last_modified_at = 0 THEN strftime('%s', 'now') ELSE last_modified_at END
    WHERE id = new.id;
END;
-- SY <--

getCategory:
SELECT id,name,`order`,flags,hidden,version,uid,last_modified_at,
-- KNS -->
parent_id, track_status, update_interval, date_added, date_modified
-- KNS <--
FROM category
WHERE id = :id
LIMIT 1;

getCategories:
SELECT
id AS id,
name,
`order`,
flags,
-- KMK -->
hidden,
-- KMK <--
version,
uid,
last_modified_at,
-- KNS -->
parent_id, track_status, update_interval, date_added, date_modified
-- KNS <--
FROM category
ORDER BY `order`;

getCategoriesByMangaId:
SELECT
C.id AS id,
C.name,
C.`order`,
C.flags,
-- KMK -->
C.hidden,
-- KMK <--
C.version,
C.uid,
C.last_modified_at,
-- KNS -->
C.parent_id, C.track_status, C.update_interval, C.date_added, C.date_modified
-- KNS <--
FROM category C
JOIN manga_category MC
ON C.id = MC.category_id
WHERE MC.manga_id = :mangaId
ORDER BY C.`order`;

getCategoriesByMangaIds:
SELECT MC.manga_id, C.id, C.name, C.`order`, C.flags, C.hidden, C.version, C.uid, C.last_modified_at,
-- KNS -->
C.parent_id, C.track_status, C.update_interval, C.date_added, C.date_modified
-- KNS <--
FROM category C
JOIN manga_category MC
ON C.id = MC.category_id
WHERE MC.manga_id IN :mangaIds
ORDER BY MC.manga_id, C.`order`;

-- KMK --> mihon b4a3ec0b32: the async driver only runs the first statement of a multi-statement
-- query, so the trailing `SELECT last_insert_rowid()` never executes; use `RETURNING id` instead
insert:
INSERT INTO category(
    name, `order`, flags, hidden, version, uid, last_modified_at, is_syncing,
    -- KNS -->
    parent_id, track_status, update_interval, date_added, date_modified
    -- KNS <--
)
VALUES (
    :name, :order, :flags, :hidden, :version, :uid, :lastModifiedAt, :isSyncing,
    -- KNS -->
    :parentId, :trackStatus, :updateInterval, :dateAdded, :dateModified
    -- KNS <--
)
RETURNING id;

insertWithNextOrder:
INSERT INTO category(
    name, `order`, flags, hidden, version, uid, last_modified_at, is_syncing,
    -- KNS -->
    parent_id, track_status, update_interval, date_added, date_modified
    -- KNS <--
)
VALUES (
    :name,
    (SELECT coalesce(max(`order`), -1) + 1 FROM category),
    :flags, :hidden, :version, :uid, :lastModifiedAt, :isSyncing,
    -- KNS -->
    :parentId, :trackStatus, :updateInterval, :dateAdded, :dateModified
    -- KNS <--
)
RETURNING id;
-- KMK <--

delete:
DELETE FROM category
WHERE id = :categoryId;

-- KMK -->
update:
UPDATE category
SET name = coalesce(:name, name),
    `order` = coalesce(:order, `order`),
    flags = coalesce(:flags, flags),
    hidden = coalesce(:hidden, hidden),
    -- SY -->
    version = coalesce(:version, version),
    uid = coalesce(:uid, uid),
    last_modified_at = coalesce(:lastModifiedAt, last_modified_at),
    is_syncing = coalesce(:isSyncing, is_syncing),
    -- SY <--
    -- KNS -->
    parent_id = coalesce(:parentId, parent_id),
    date_modified = coalesce(:dateModified, date_modified)
    -- KNS <--
WHERE id = :categoryId;
-- KMK <--

-- KNS -->
-- Nullable settings need explicit writes: coalesce() could never clear them back to NULL.
updateTrackStatus:
UPDATE category
SET track_status = :trackStatus,
    date_modified = :dateModified
WHERE id = :categoryId;

updateUpdateInterval:
UPDATE category
SET update_interval = :updateInterval,
    date_modified = :dateModified
WHERE id = :categoryId;
-- KNS <--

updateName:
UPDATE category
SET name = :name
WHERE id = :categoryId;

getUserCategoryIds:
SELECT id
FROM category
WHERE id > 0
ORDER BY `order`;

updateOrder:
UPDATE category
SET `order` = :order
WHERE id = :categoryId;

updateFlags:
UPDATE category
SET flags = :flags
WHERE id = :categoryId;

-- SY -->
-- KUN -->
-- One-shot force push: every user category wins the version-first merge. The system category
-- (id 0) is not synced, so it is excluded. `last_modified_at` only moves forward so a concurrent
-- rename stays in the next delta.
forcePushVersions:
UPDATE category
SET version = max(version, :version),
    last_modified_at = max(last_modified_at, :lastModifiedAt)
WHERE id > 0;
-- KUN <--

resetIsSyncing:
UPDATE category
SET is_syncing = 0
WHERE is_syncing = 1;
-- SY <--

updateAllFlags:
UPDATE category SET
flags = coalesce(:flags, flags);
