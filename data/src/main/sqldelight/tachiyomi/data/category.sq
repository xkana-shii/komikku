import kotlin.Long;
import kotlin.collections.List;

CREATE TABLE category(
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    `order` INTEGER NOT NULL UNIQUE,
    flags INTEGER NOT NULL,
    manga_order TEXT AS List<Long> NOT NULL,
    -- KMK -->
    hidden INTEGER DEFAULT 0 NOT NULL,
    parent_id INTEGER NOT NULL DEFAULT 0,
    track_status INTEGER,
    update_interval INTEGER
    -- KMK <--
);

-- Insert system category
INSERT OR IGNORE INTO category(id, name, `order`, flags, manga_order, hidden) VALUES (0, "", -1, 0, "", 0);
-- Disallow deletion of default category
CREATE TRIGGER IF NOT EXISTS system_category_delete_trigger BEFORE DELETE
ON category
BEGIN SELECT CASE
    WHEN old.id <= 0 THEN
        RAISE(ABORT, "System category can't be deleted")
    END;
END;

getCategory:
SELECT id,name,`order`,flags,hidden,parent_id,track_status,update_interval
FROM category
WHERE id = :id;

getCategories:
SELECT
id AS id,
name,
`order`,
flags,
-- KMK -->
hidden,
parent_id,
track_status,
update_interval
-- KMK <--
FROM category
ORDER BY `order`;

getCategoriesByMangaId:
SELECT
C.id AS id,
C.name,
C.`order`,
C.flags,
-- KMK -->
C.hidden,
C.parent_id,
C.track_status,
C.update_interval
-- KMK <--
FROM category C
JOIN manga_category MC
ON C.id = MC.category_id
WHERE MC.manga_id = :mangaId
ORDER BY C.`order`;

insert:
INSERT INTO category(name, `order`, flags, manga_order, hidden, parent_id)
VALUES (:name, :order, :flags, "", :hidden, :parentId);

-- KMK -->
insertReturningId:
INSERT INTO category(name, `order`, flags, manga_order, hidden, parent_id)
VALUES (:name, :order, :flags, "", :hidden, :parentId)
RETURNING id;
-- KMK <--

delete:
DELETE FROM category
WHERE id = :id;

updateName:
UPDATE category
SET name = :name
WHERE id = :id;

getUserCategoryIds:
SELECT id
FROM category
WHERE id > 0
ORDER BY `order`;

updateOrder:
UPDATE category
SET `order` = :order
WHERE id = :id;

updateFlags:
UPDATE category
SET flags = :flags
WHERE id = :id;

-- KMK -->
updateNameAndOrder:
UPDATE category
SET name = :name, `order` = :order
WHERE id = :categoryId;

updateHidden:
UPDATE category
SET hidden = :hidden
WHERE id = :categoryId;

-- KMK -->
getSubcategories:
SELECT id,name,`order`,flags,hidden,parent_id,track_status,update_interval
FROM category
WHERE parent_id = :parentId
ORDER BY `order`;

getTopLevelCategories:
SELECT id,name,`order`,flags,hidden,parent_id,track_status,update_interval
FROM category
WHERE parent_id = 0
ORDER BY `order`;

updateParent:
UPDATE category
SET parent_id = :parentId
WHERE id = :categoryId;

reparentChildren:
UPDATE category
SET parent_id = :parentId
WHERE parent_id = :categoryId;

updateTrackStatus:
UPDATE category
SET track_status = :trackStatus
WHERE id = :categoryId;

updateUpdateInterval:
UPDATE category
SET update_interval = :updateInterval
WHERE id = :categoryId;
-- KMK <--
-- KMK <--

updateAllFlags:
UPDATE category
SET flags = :flags;
