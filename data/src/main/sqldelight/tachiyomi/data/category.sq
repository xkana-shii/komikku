import kotlin.Long;
import kotlin.collections.List;

CREATE TABLE category(
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    `order` INTEGER NOT NULL UNIQUE,
    flags INTEGER NOT NULL,
    -- KMK -->
    manga_order TEXT AS List<Long> NOT NULL,
    hidden INTEGER DEFAULT 0 NOT NULL
    -- KMK <--
, parent_id INTEGER NOT NULL DEFAULT 0, track_status INTEGER, update_interval INTEGER, date_added INTEGER NOT NULL DEFAULT 0, date_modified INTEGER NOT NULL DEFAULT 0, version INTEGER NOT NULL DEFAULT 0, uid INTEGER NOT NULL DEFAULT 0, last_modified_at INTEGER NOT NULL DEFAULT 0, is_syncing INTEGER NOT NULL DEFAULT 0
);

-- Insert system category
INSERT OR IGNORE INTO category(id, name, `order`, flags, manga_order, hidden, version, uid, last_modified_at, is_syncing) VALUES (0, "", -1, 0, "", 0, 0, 0, 0, 0);
-- Disallow deletion of default category
CREATE TRIGGER IF NOT EXISTS system_category_delete_trigger BEFORE DELETE
ON category
BEGIN SELECT CASE
    WHEN old.id <= 0 THEN
        -- KMK -->
        RAISE(ABORT, 'System category can''t be deleted')
        -- KMK <--
    END;
END;

-- SY -->
CREATE TRIGGER update_category_version AFTER UPDATE ON category
WHEN new.is_syncing = 0 AND (
    new.name != old.name OR
    new.`order` != old.`order` OR
    new.flags != old.flags
    -- KMK -->
    OR new.hidden != old.hidden
    -- KMK <--
    -- KMK -->
    OR new.parent_id != old.parent_id OR
    new.track_status IS NOT old.track_status OR
    new.update_interval IS NOT old.update_interval
    -- KMK <--
)
BEGIN
    UPDATE category
    SET version = version + 1,
        last_modified_at = strftime('%s', 'now')
    WHERE id = new.id;
END;

CREATE TRIGGER insert_category_uid AFTER INSERT ON category
-- KMK --> a sync restore inserts with is_syncing = 1; it must keep the backup's last_modified_at
WHEN new.is_syncing = 0
-- KMK <--
BEGIN
    UPDATE category
    SET uid = CASE WHEN uid = 0 THEN abs(random()) ELSE uid END,
        last_modified_at = CASE WHEN last_modified_at = 0 THEN strftime('%s', 'now') ELSE last_modified_at END
    WHERE id = new.id;
END;
-- SY <--

getCategory:
SELECT id,name,`order`,flags,manga_order,hidden,parent_id,date_added,date_modified,track_status,update_interval,version,uid,last_modified_at
FROM category
WHERE id = :id
LIMIT 1;

getCategories:
SELECT
id AS id,
name,
`order`,
flags,
-- KMK -->
manga_order,
hidden,
-- KMK <--
parent_id,
date_added,
date_modified,
track_status,
update_interval,
version,
uid,
last_modified_at
FROM category
ORDER BY `order`;

getCategoriesByMangaId:
SELECT
C.id AS id,
C.name,
C.`order`,
C.flags,
-- KMK -->
C.manga_order,
C.hidden,
-- KMK <--
C.parent_id,
C.date_added,
C.date_modified,
C.track_status,
C.update_interval,
C.version,
C.uid,
C.last_modified_at
FROM category C
JOIN manga_category MC
ON C.id = MC.category_id
WHERE MC.manga_id = :mangaId
ORDER BY C.`order`;

getCategoriesByMangaIds:
SELECT MC.manga_id, C.id, C.name, C.`order`, C.flags, C.manga_order, C.hidden, C.parent_id, C.date_added, C.date_modified,
    C.track_status, C.update_interval, C.version, C.uid, C.last_modified_at
FROM category C
JOIN manga_category MC
ON C.id = MC.category_id
WHERE MC.manga_id IN :mangaIds
ORDER BY MC.manga_id, C.`order`;

-- KMK --> mihon b4a3ec0b32: the async driver only runs the first statement of a multi-statement
-- query, so the trailing `SELECT last_insert_rowid()` never executes; use `RETURNING id` instead
insert:
INSERT INTO category(name, `order`, flags, manga_order, hidden, parent_id, date_added, date_modified, track_status, update_interval,
    version, uid, last_modified_at, is_syncing)
VALUES (:name, :order, :flags, :mangaOrder, :hidden, :parentId, :dateAdded, :dateModified, :trackStatus, :updateInterval,
    :version, :uid, :lastModifiedAt, :isSyncing)
RETURNING id;

insertWithNextOrder:
INSERT INTO category(name, `order`, flags, manga_order, hidden, parent_id, date_added, date_modified, track_status, update_interval,
    version, uid, last_modified_at, is_syncing)
VALUES (
    :name,
    (SELECT coalesce(max(`order`), -1) + 1 FROM category),
    :flags, :mangaOrder, :hidden, :parentId, :dateAdded, :dateModified, :trackStatus, :updateInterval,
    :version, :uid, :lastModifiedAt, :isSyncing
)
RETURNING id;
-- KMK <--

delete:
DELETE FROM category
WHERE id = :categoryId;

-- KMK -->
update:
UPDATE category
SET name = coalesce(:name, name),
    `order` = coalesce(:order, `order`),
    flags = coalesce(:flags, flags),
    hidden = coalesce(:hidden, hidden),
    parent_id = coalesce(:parentId, parent_id),
    track_status = coalesce(:trackStatus, track_status),
    update_interval = coalesce(:updateInterval, update_interval),
    date_modified = coalesce(:dateModified, date_modified),
    -- SY -->
    version = coalesce(:version, version),
    uid = coalesce(:uid, uid),
    last_modified_at = coalesce(:lastModifiedAt, last_modified_at),
    is_syncing = coalesce(:isSyncing, is_syncing)
    -- SY <--
WHERE id = :categoryId;
-- KMK <--

updateName:
UPDATE category
SET name = :name
WHERE id = :categoryId;

-- KMK -->
updateNameAndOrder:
UPDATE category
SET name = :name, `order` = :order, date_modified = :dateModified
WHERE id = :categoryId;

updateHidden:
UPDATE category
SET hidden = :hidden, date_modified = :dateModified
WHERE id = :categoryId;

getSubcategories:
SELECT id,name,`order`,flags,manga_order,hidden,parent_id,date_added,date_modified,track_status,update_interval,version,uid,last_modified_at
FROM category
WHERE parent_id = :parentId
ORDER BY `order`;

getTopLevelCategories:
SELECT id,name,`order`,flags,manga_order,hidden,parent_id,date_added,date_modified,track_status,update_interval,version,uid,last_modified_at
FROM category
WHERE parent_id = 0
ORDER BY `order`;

updateParent:
UPDATE category
SET parent_id = :parentId, date_modified = :dateModified
WHERE id = :categoryId;

reparentChildren:
UPDATE category
SET parent_id = :parentId, date_modified = :dateModified
WHERE parent_id = :categoryId;

updateTrackStatus:
UPDATE category
SET track_status = :trackStatus, date_modified = :dateModified
WHERE id = :categoryId;

updateUpdateInterval:
UPDATE category
SET update_interval = :updateInterval, date_modified = :dateModified
WHERE id = :categoryId;
-- KMK <--

getUserCategoryIds:
SELECT id
FROM category
WHERE id > 0
ORDER BY `order`;

updateOrder:
UPDATE category
SET `order` = :order
WHERE id = :categoryId;

updateFlags:
UPDATE category
SET flags = :flags
WHERE id = :categoryId;

-- SY -->
resetIsSyncing:
UPDATE category
SET is_syncing = 0
WHERE is_syncing = 1;
-- SY <--

updateAllFlags:
UPDATE category SET flags = :flags;
