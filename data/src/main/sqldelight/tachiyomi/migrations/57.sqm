-- KMK -->
-- Adopt SyncYomi v2's final column names without rewriting the released Komikku
-- migrations. All Komikku-only columns and their data remain in place.

DROP TRIGGER IF EXISTS update_last_modified_at_mangas;
DROP TRIGGER IF EXISTS update_manga_version;
DROP TRIGGER IF EXISTS update_last_modified_at_chapters;
DROP TRIGGER IF EXISTS update_chapter_and_manga_version;
DROP TRIGGER IF EXISTS update_last_modified_at_mangas_categories;
DROP TRIGGER IF EXISTS insert_manga_category_update_version;
DROP TRIGGER IF EXISTS delete_manga_category_update_version;

ALTER TABLE manga RENAME COLUMN state_last_modified_at TO last_modified_at;
ALTER TABLE manga RENAME COLUMN state_version TO version;
ALTER TABLE manga RENAME COLUMN state_is_syncing TO is_syncing;
ALTER TABLE manga ADD COLUMN favorite_modified_at INTEGER;

ALTER TABLE chapter RENAME COLUMN state_last_modified_at TO last_modified_at;
ALTER TABLE chapter RENAME COLUMN state_version TO version;
ALTER TABLE chapter RENAME COLUMN state_is_syncing TO is_syncing;

ALTER TABLE manga_category RENAME COLUMN state_last_modified_at TO last_modified_at;

ALTER TABLE category ADD COLUMN version INTEGER NOT NULL DEFAULT 0;
ALTER TABLE category ADD COLUMN uid INTEGER NOT NULL DEFAULT 0;
ALTER TABLE category ADD COLUMN last_modified_at INTEGER NOT NULL DEFAULT 0;
ALTER TABLE category ADD COLUMN is_syncing INTEGER NOT NULL DEFAULT 0;

UPDATE manga
SET favorite_modified_at = strftime('%s', 'now')
WHERE user_favorite_at IS NOT NULL;

UPDATE category
SET uid = abs(random()),
    last_modified_at = strftime('%s', 'now')
WHERE id > 0;

CREATE TRIGGER update_last_modified_at_mangas
AFTER UPDATE ON manga
FOR EACH ROW
WHEN new.is_syncing = 0 AND old.is_syncing = 0
BEGIN
  UPDATE manga
  SET last_modified_at = strftime('%s', 'now')
  WHERE id = new.id;
END;

CREATE TRIGGER update_last_favorited_at_mangas
AFTER UPDATE OF user_favorite_at ON manga
WHEN new.user_favorite_at IS NOT old.user_favorite_at
    OR (new.user_favorite_at IS NOT NULL AND old.favorite_modified_at IS NULL)
BEGIN
  UPDATE manga
  SET favorite_modified_at = strftime('%s', 'now')
  WHERE id = new.id;
END;

CREATE TRIGGER update_manga_version AFTER UPDATE ON manga
BEGIN
    UPDATE manga SET version = version + 1
    WHERE id = new.id AND new.is_syncing = 0 AND (
        new.remote_url != old.remote_url OR
        new.remote_description != old.remote_description OR
        new.user_favorite_at IS NOT old.user_favorite_at
    );
END;

CREATE TRIGGER update_last_modified_at_chapters
AFTER UPDATE ON chapter
FOR EACH ROW
WHEN new.is_syncing = 0 AND old.is_syncing = 0
BEGIN
  UPDATE chapter
  SET last_modified_at = strftime('%s', 'now')
  WHERE id = new.id;
END;

CREATE TRIGGER update_chapter_and_manga_version AFTER UPDATE ON chapter
WHEN new.is_syncing = 0 AND (
    new.user_read != old.user_read OR
    new.user_bookmark != old.user_bookmark OR
    new.user_fillermark != old.user_fillermark OR
    new.user_bookmark_color != old.user_bookmark_color OR
    new.user_last_page_read != old.user_last_page_read
)
BEGIN
    UPDATE chapter SET version = version + 1
    WHERE id = new.id;
END;

CREATE TRIGGER update_last_modified_at_mangas_categories
AFTER UPDATE ON manga_category
FOR EACH ROW
BEGIN
  UPDATE manga_category
  SET last_modified_at = strftime('%s', 'now')
  WHERE manga_id = new.manga_id AND category_id = new.category_id;
END;

CREATE TRIGGER insert_manga_category_update_version AFTER INSERT ON manga_category
BEGIN
    UPDATE manga
    SET version = version + 1
    WHERE id = new.manga_id AND (SELECT is_syncing FROM manga WHERE id = new.manga_id) = 0;
END;

CREATE TRIGGER delete_manga_category_update_version AFTER DELETE ON manga_category
BEGIN
    UPDATE manga
    SET version = version + 1
    WHERE id = old.manga_id AND (SELECT is_syncing FROM manga WHERE id = old.manga_id) = 0;
END;

CREATE TRIGGER update_category_version AFTER UPDATE ON category
WHEN new.is_syncing = 0 AND (
    new.name != old.name OR
    new.`order` != old.`order` OR
    new.flags != old.flags OR
    new.hidden != old.hidden OR
    new.parent_id != old.parent_id OR
    new.track_status IS NOT old.track_status OR
    new.update_interval IS NOT old.update_interval
)
BEGIN
    UPDATE category
    SET version = version + 1,
        last_modified_at = strftime('%s', 'now')
    WHERE id = new.id;
END;

CREATE TRIGGER insert_category_uid AFTER INSERT ON category
WHEN new.is_syncing = 0
BEGIN
    UPDATE category
    SET uid = CASE WHEN uid = 0 THEN abs(random()) ELSE uid END,
        last_modified_at = CASE WHEN last_modified_at = 0 THEN strftime('%s', 'now') ELSE last_modified_at END
    WHERE id = new.id;
END;

-- Recreate views whose source definitions changed in the integrated data model.
DROP VIEW IF EXISTS historyView;
CREATE VIEW historyView AS
SELECT
    history.id AS id,
    manga.id AS mangaId,
    chapter.id AS chapterId,
    manga.remote_title AS title,
    manga.remote_cover AS thumbnailUrl,
    manga.source_id AS sourceId,
    manga.user_favorite_at IS NOT NULL AS favorite,
    manga.state_cover_last_modified AS coverLastModified,
    chapter.remote_chapter_number AS chapterNumber,
    -- KMK -->
    manga.user_chapter_flags AS chapterFlags,
    chapter.user_read AS read,
    chapter.user_last_page_read AS lastPageRead,
    coalesce(C.total, 0) AS totalCount,
    coalesce(C.readCount, 0) AS readCount,
    coalesce(C.bookmarkCount, 0) AS bookmarkCount,
    coalesce(C.bookmarkReadCount, 0) AS bookmarkReadCount,
    -- KMK <--
    history.read_at AS readAt,
    history.read_duration AS readDuration,
    max_read.read_at AS maxReadAt,
    max_read.chapter_id AS maxReadAtChapterId
FROM manga
JOIN chapter
ON manga.id = chapter.manga_id
JOIN history
ON chapter.id = history.chapter_id
JOIN (
    SELECT manga_id, chapter_id, MAX(read_at) AS read_at
    FROM history
    GROUP BY manga_id
) AS max_read
ON chapter.manga_id = max_read.manga_id
-- KMK -->
LEFT JOIN(
    SELECT
        chapter.manga_id,
        count(*) AS total,
        sum(user_read) AS readCount,
        sum(user_bookmark) AS bookmarkCount,
        sum(CASE WHEN user_bookmark = 1 AND user_read = 1 THEN 1 ELSE 0 END) AS bookmarkReadCount,
        excluded_scanlator.scanlator AS ex_scanlator
    FROM chapter
    LEFT JOIN excluded_scanlator
    ON chapter.manga_id = excluded_scanlator.manga_id
    AND chapter.remote_scanlator = excluded_scanlator.scanlator
    WHERE ex_scanlator IS NULL
    GROUP BY chapter.manga_id
) AS C
ON manga.id = C.manga_id;

DROP VIEW IF EXISTS libraryUpdateErrorView;
CREATE VIEW libraryUpdateErrorView AS
SELECT
    manga.id AS mangaId,
    manga.remote_title AS mangaTitle,
    manga.source_id AS mangaSource,
    manga.user_favorite_at IS NOT NULL AS favorite,
    manga.remote_cover AS mangaThumbnail,
    manga.state_cover_last_modified AS coverLastModified,
    libraryUpdateError._id AS errorId,
    libraryUpdateError.message_id AS messageId,
    libraryUpdateError.last_update AS lastUpdate
FROM manga JOIN libraryUpdateError
ON manga.id = libraryUpdateError.manga_id
WHERE user_favorite_at IS NOT NULL
ORDER BY lastUpdate DESC;

DROP VIEW IF EXISTS libraryView;
CREATE VIEW libraryView AS
SELECT
    M.*,
    coalesce(C.total, 0) AS totalCount,
    coalesce(C.readCount, 0) AS readCount,
    C.latestUpload AS latestUpload,
    C.fetchedAt AS chapterFetchedAt,
    -- Joining history to every chapter is the slowest part of the query, and only entries with excluded
    -- scanlators need the chapters to leave theirs out
    CASE WHEN EXISTS (SELECT 0 FROM excluded_scanlator WHERE excluded_scanlator.manga_id = M.id)
    THEN (
        SELECT max(history.read_at)
        FROM history
        JOIN chapter
        ON chapter.id = history.chapter_id
        WHERE history.manga_id = M.id
        AND NOT EXISTS (
            SELECT 0 FROM excluded_scanlator
            WHERE excluded_scanlator.manga_id = M.id
            AND excluded_scanlator.scanlator = chapter.remote_scanlator
        )
    )
    ELSE (SELECT max(history.read_at) FROM history WHERE history.manga_id = M.id)
    END AS lastRead,
    coalesce(C.bookmarkCount, 0) AS bookmarkCount,
    -- KMK -->
    coalesce(C.bookmarkReadCount, 0) AS bookmarkedReadCount,
    -- KMK <--
    coalesce(MC.categories, '0') AS categories,
    -- KMK -->
    coalesce((SELECT revision FROM library_visibility_revision WHERE manga_id = M.id), 0) AS visibilityRevision
    -- KMK <--
FROM manga M
LEFT JOIN (
    SELECT
        chapter.manga_id,
        count(*) AS total,
        sum(user_read) AS readCount,
        max(chapter.remote_date_upload) AS latestUpload,
        max(chapter.state_date_fetch) AS fetchedAt,
        sum(user_bookmark) AS bookmarkCount,
        -- KMK -->
        sum(CASE WHEN user_bookmark = 1 AND user_read = 1 THEN 1 ELSE 0 END) AS bookmarkReadCount,
        -- KMK <--
        excluded_scanlator.scanlator AS ex_scanlator
    FROM chapter
    LEFT JOIN excluded_scanlator
    ON chapter.manga_id = excluded_scanlator.manga_id
    AND chapter.remote_scanlator = excluded_scanlator.scanlator
    WHERE ex_scanlator IS NULL
    GROUP BY chapter.manga_id
) AS C
ON M.id = C.manga_id
LEFT JOIN (
    SELECT manga_id, group_concat(category_id) AS categories
    FROM manga_category
    GROUP BY manga_id
) AS MC
ON MC.manga_id = M.id
WHERE M.source_id <> 6969
UNION
SELECT
    M.*,
    coalesce(C.total, 0) AS totalCount,
    coalesce(C.readCount, 0) AS readCount,
    C.latestUpload AS latestUpload,
    C.fetchedAt AS chapterFetchedAt,
    -- KMK -->
    -- Same as the non-merged branch above, but over every manga of the merge group
    CASE WHEN EXISTS (
        SELECT 0 FROM excluded_scanlator
        WHERE excluded_scanlator.manga_id IN (SELECT manga_id FROM merged WHERE merge_id = M.id)
    )
    THEN (
        SELECT max(history.read_at)
        FROM history
        JOIN chapter
        ON chapter.id = history.chapter_id
        WHERE history.manga_id IN (SELECT manga_id FROM merged WHERE merge_id = M.id)
        AND NOT EXISTS (
            SELECT 0 FROM excluded_scanlator
            WHERE excluded_scanlator.manga_id = history.manga_id
            AND excluded_scanlator.scanlator = chapter.remote_scanlator
        )
    )
    ELSE (
        SELECT max(history.read_at)
        FROM history
        WHERE history.manga_id IN (SELECT manga_id FROM merged WHERE merge_id = M.id)
    )
    END AS lastRead,
    -- KMK <--
    coalesce(C.bookmarkCount, 0) AS bookmarkCount,
    -- KMK -->
    coalesce(C.bookmarkReadCount, 0) AS bookmarkedReadCount,
    -- KMK <--
    coalesce(MC.categories, '0') AS categories,
    -- KMK -->
    coalesce((SELECT revision FROM library_visibility_revision WHERE manga_id = M.id), 0) AS visibilityRevision
    -- KMK <--
FROM manga M
LEFT JOIN (
    SELECT merged.manga_id,merged.merge_id
    FROM merged
    GROUP BY merged.merge_id
) AS ME
ON ME.merge_id = M.id
LEFT JOIN(
    SELECT
        ME.merge_id,
        count(*) AS total,
        sum(user_read) AS readCount,
        max(chapter.remote_date_upload) AS latestUpload,
        max(chapter.state_date_fetch) AS fetchedAt,
        sum(user_bookmark) AS bookmarkCount,
        -- KMK -->
        sum(CASE WHEN user_bookmark = 1 AND user_read = 1 THEN 1 ELSE 0 END) AS bookmarkReadCount,
        -- KMK <--
        excluded_scanlator.scanlator AS ex_scanlator
    FROM chapter
    LEFT JOIN excluded_scanlator
    ON chapter.manga_id = excluded_scanlator.manga_id
    AND chapter.remote_scanlator = excluded_scanlator.scanlator
    LEFT JOIN merged ME
    ON ME.manga_id = chapter.manga_id
    WHERE ex_scanlator IS NULL
    GROUP BY ME.merge_id
) AS C
ON M.id = C.merge_id  -- ON ME.merge_id = C.merge_id
LEFT JOIN (
    SELECT manga_id, group_concat(category_id) AS categories
    FROM manga_category
    GROUP BY manga_id
) AS MC
ON MC.manga_id = M.id
WHERE M.source_id = 6969;

DROP VIEW IF EXISTS updatesView;
CREATE VIEW updatesView AS
SELECT
    manga.id AS mangaId,
    manga.remote_title AS mangaTitle,
    chapter.id AS chapterId,
    chapter.remote_name AS chapterName,
    chapter.remote_scanlator AS scanlator,
    chapter.remote_url AS chapterUrl,
    chapter.user_read AS read,
    chapter.user_bookmark AS bookmark,
    -- KMK -->
    chapter.user_bookmark_color AS bookmarkColor,
    -- KMK <--
    chapter.user_last_page_read AS lastPageRead,
    manga.source_id AS sourceId,
    manga.user_favorite_at IS NOT NULL AS favorite,
    manga.remote_cover AS thumbnailUrl,
    manga.state_cover_last_modified AS coverLastModified,
    chapter.remote_date_upload AS dateUpload,
    chapter.state_date_fetch AS dateFetch,
    excluded_scanlator.scanlator AS excludedScanlator
FROM manga JOIN chapter
ON manga.id = chapter.manga_id
LEFT JOIN excluded_scanlator
ON manga.id = excluded_scanlator.manga_id
AND chapter.remote_scanlator = excluded_scanlator.scanlator
WHERE manga.user_favorite_at IS NOT NULL AND manga.source_id <> 6969
-- KMK -->
AND chapter.state_date_fetch > manga.state_date_added
-- KMK <--
UNION
SELECT
    manga.id AS mangaId,
    manga.remote_title AS mangaTitle,
    chapter.id AS chapterId,
    chapter.remote_name AS chapterName,
    chapter.remote_scanlator AS scanlator,
    chapter.remote_url AS chapterUrl,
    chapter.user_read AS read,
    chapter.user_bookmark AS bookmark,
    -- KMK -->
    chapter.user_bookmark_color AS bookmarkColor,
    -- KMK <--
    chapter.user_last_page_read AS lastPageRead,
    manga.source_id AS sourceId,
    manga.user_favorite_at IS NOT NULL AS favorite,
    manga.remote_cover AS thumbnailUrl,
    manga.state_cover_last_modified AS coverLastModified,
    chapter.remote_date_upload AS dateUpload,
    chapter.state_date_fetch AS dateFetch,
    excluded_scanlator.scanlator AS excludedScanlator
FROM manga
LEFT JOIN (
    SELECT merged.manga_id,merged.merge_id
    FROM merged
    GROUP BY merged.merge_id
) AS ME
ON ME.merge_id = manga.id
JOIN chapter
ON ME.manga_id = chapter.manga_id
LEFT JOIN excluded_scanlator
ON manga.id = excluded_scanlator.manga_id
AND chapter.remote_scanlator = excluded_scanlator.scanlator
WHERE manga.user_favorite_at IS NOT NULL AND manga.source_id = 6969
-- KMK -->
AND chapter.state_date_fetch > manga.state_date_added
-- KMK <--
ORDER BY dateFetch DESC;

-- KMK <--
