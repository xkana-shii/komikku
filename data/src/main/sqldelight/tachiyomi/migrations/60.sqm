-- KNS -->
-- Append the editable-metadata schema after fork migrations 57/58. The two query views name
-- columns explicitly, so rebuild them with both upstream user overrides and fork bookmark colors.
ALTER TABLE manga ADD COLUMN user_title TEXT;
ALTER TABLE manga ADD COLUMN user_author TEXT;
ALTER TABLE manga ADD COLUMN user_artist TEXT;
ALTER TABLE manga ADD COLUMN user_thumbnail_url TEXT;
ALTER TABLE manga ADD COLUMN user_description TEXT;
ALTER TABLE manga ADD COLUMN user_genre TEXT;
ALTER TABLE manga ADD COLUMN user_status INTEGER;

DROP VIEW IF EXISTS updatesView;
DROP VIEW IF EXISTS historyView;

CREATE VIEW updatesView AS
SELECT manga.id AS mangaId, manga.remote_title AS mangaTitle, chapter.id AS chapterId,
    chapter.remote_name AS chapterName, chapter.remote_scanlator AS scanlator, chapter.remote_url AS chapterUrl,
    chapter.user_read AS read, chapter.user_bookmark AS bookmark, chapter.user_bookmark_color AS bookmarkColor,
    chapter.user_last_page_read AS lastPageRead, manga.source_id AS sourceId,
    manga.user_favorite_at IS NOT NULL AS favorite, manga.remote_cover AS thumbnailUrl,
    manga.state_cover_last_modified AS coverLastModified, chapter.remote_date_upload AS dateUpload,
    chapter.state_date_fetch AS dateFetch, excluded_scanlator.scanlator AS excludedScanlator,
    manga.user_title AS userTitle, manga.user_thumbnail_url AS userThumbnailUrl
FROM manga JOIN chapter ON manga.id = chapter.manga_id
LEFT JOIN excluded_scanlator ON manga.id = excluded_scanlator.manga_id AND chapter.remote_scanlator = excluded_scanlator.scanlator
WHERE manga.user_favorite_at IS NOT NULL AND manga.source_id <> 6969 AND chapter.state_date_fetch > manga.user_favorite_at
UNION
SELECT manga.id AS mangaId, manga.remote_title AS mangaTitle, chapter.id AS chapterId,
    chapter.remote_name AS chapterName, chapter.remote_scanlator AS scanlator, chapter.remote_url AS chapterUrl,
    chapter.user_read AS read, chapter.user_bookmark AS bookmark, chapter.user_bookmark_color AS bookmarkColor,
    chapter.user_last_page_read AS lastPageRead, manga.source_id AS sourceId,
    manga.user_favorite_at IS NOT NULL AS favorite, manga.remote_cover AS thumbnailUrl,
    manga.state_cover_last_modified AS coverLastModified, chapter.remote_date_upload AS dateUpload,
    chapter.state_date_fetch AS dateFetch, excluded_scanlator.scanlator AS excludedScanlator,
    manga.user_title AS userTitle, manga.user_thumbnail_url AS userThumbnailUrl
FROM manga JOIN merged AS ME ON ME.merge_id = manga.id JOIN chapter ON ME.manga_id = chapter.manga_id
LEFT JOIN excluded_scanlator ON manga.id = excluded_scanlator.manga_id AND chapter.remote_scanlator = excluded_scanlator.scanlator
WHERE manga.user_favorite_at IS NOT NULL AND manga.source_id = 6969 AND chapter.state_date_fetch > manga.user_favorite_at
ORDER BY dateFetch DESC;

CREATE VIEW historyView AS
SELECT history.id AS id, manga.id AS mangaId, chapter.id AS chapterId, manga.remote_title AS title,
    manga.remote_cover AS thumbnailUrl, manga.source_id AS sourceId,
    manga.user_favorite_at IS NOT NULL AS favorite, manga.state_cover_last_modified AS coverLastModified,
    chapter.remote_chapter_number AS chapterNumber, manga.user_chapter_flags AS chapterFlags,
    chapter.user_read AS read, chapter.user_last_page_read AS lastPageRead,
    coalesce(C.total, 0) AS totalCount, coalesce(C.readCount, 0) AS readCount,
    coalesce(C.bookmarkCount, 0) AS bookmarkCount, coalesce(C.bookmarkReadCount, 0) AS bookmarkReadCount,
    history.read_at AS readAt, history.read_duration AS readDuration, max_read.read_at AS maxReadAt,
    max_read.chapter_id AS maxReadAtChapterId, manga.user_title AS userTitle,
    manga.user_thumbnail_url AS userThumbnailUrl
FROM manga JOIN chapter ON manga.id = chapter.manga_id JOIN history ON chapter.id = history.chapter_id
JOIN (SELECT manga_id, chapter_id, MAX(read_at) AS read_at FROM history GROUP BY manga_id) AS max_read
    ON chapter.manga_id = max_read.manga_id
LEFT JOIN (
    SELECT chapter.manga_id, count(*) AS total, sum(user_read) AS readCount, sum(user_bookmark) AS bookmarkCount,
        sum(CASE WHEN user_bookmark = 1 AND user_read = 1 THEN 1 ELSE 0 END) AS bookmarkReadCount,
        excluded_scanlator.scanlator AS ex_scanlator
    FROM chapter LEFT JOIN excluded_scanlator ON chapter.manga_id = excluded_scanlator.manga_id
        AND chapter.remote_scanlator = excluded_scanlator.scanlator
    WHERE ex_scanlator IS NULL GROUP BY chapter.manga_id
) AS C ON manga.id = C.manga_id;
