import kotlin.Boolean;

-- KNS -->
-- Komi-kun's 61.sqm ("Improve Merged Manga database schema"), renumbered: this fork's 61 and 62 hold
-- Komi-kun's 59 and 60, its own 59 and 60 having shipped first. The views at the end are recreated
-- exactly as view/libraryView.sq and view/updatesView.sq declare them, with this fork's columns.
-- KNS <--
-- KUN -->
-- Split the merged table into merge (merge-level settings) + merged_entry (per-entry settings).
-- The self-reference (manga_source 6969 = MERGED_SOURCE_ID) carried chapter_sort_mode and the
-- info flag; those move to the merge row. Entries whose child manga is gone are dropped: the new
-- table requires a resolvable manga id. Entry settings (fetch updates, downloads, priority) stay
-- per entry.
--
-- The sort-mode values are copied as they are: this fork already renumbered them (Komikku #1194
-- dropped the "No dedupe" mode, see MergeSettings' constants), so no remap is needed here.
CREATE TABLE merge(
    manga_id INTEGER NOT NULL PRIMARY KEY,
    chapter_sort_mode INTEGER NOT NULL DEFAULT 0,
    info_manga_id INTEGER,
    FOREIGN KEY(manga_id) REFERENCES manga (id)
    ON DELETE CASCADE,
    FOREIGN KEY(info_manga_id) REFERENCES manga (id)
    ON DELETE SET NULL
);

CREATE TABLE merged_entry(
    _id INTEGER NOT NULL PRIMARY KEY,
    merge_id INTEGER NOT NULL,
    manga_id INTEGER NOT NULL,
    fetch_chapter_updates INTEGER AS Boolean NOT NULL DEFAULT 1,
    download_chapters INTEGER AS Boolean NOT NULL DEFAULT 1,
    chapter_priority INTEGER NOT NULL DEFAULT 0,
    UNIQUE(merge_id, manga_id),
    FOREIGN KEY(merge_id) REFERENCES merge (manga_id)
    ON DELETE CASCADE,
    FOREIGN KEY(manga_id) REFERENCES manga (id)
    ON DELETE CASCADE
);

CREATE INDEX merged_entry_merge_id_index ON merged_entry(merge_id);

INSERT INTO merge(manga_id, chapter_sort_mode, info_manga_id)
SELECT
    m.merge_id,
    coalesce((SELECT s.chapter_sort_mode FROM merged s
              WHERE s.merge_id = m.merge_id AND s.manga_source = 6969
              LIMIT 1), 0),
    (SELECT i.manga_id FROM merged i
     WHERE i.merge_id = m.merge_id AND i.info_manga = 1 AND i.manga_id IS NOT NULL
     LIMIT 1)
FROM (SELECT DISTINCT merge_id FROM merged) m;

INSERT INTO merged_entry(merge_id, manga_id, fetch_chapter_updates, download_chapters, chapter_priority)
SELECT merge_id, manga_id, get_chapter_updates, download_chapters, chapter_priority
FROM merged
WHERE manga_source <> 6969 AND manga_id IS NOT NULL;

DROP TABLE merged;
-- KUN <--

-- Both feeds join the merge tables for the merge's chapters and sort mode; views are stored as
-- text, so they are recreated, not edited.
DROP VIEW IF EXISTS libraryView;
DROP VIEW IF EXISTS updatesView;

-- NOTE: must update MERGED_SOURCE_ID (6969) here
CREATE VIEW libraryView AS
SELECT
    M.*,
    coalesce(C.total, 0) AS totalCount,
    coalesce(C.readCount, 0) AS readCount,
    C.latestUpload AS latestUpload,
    C.fetchedAt AS chapterFetchedAt,
    -- Joining history to every chapter is the slowest part of the query, and only entries with excluded
    -- scanlators need the chapters to leave theirs out
    CASE WHEN EXISTS (SELECT 0 FROM excluded_scanlator WHERE excluded_scanlator.manga_id = M.id)
    THEN (
        SELECT max(history.read_at)
        FROM history
        JOIN chapter
        ON chapter.id = history.chapter_id
        WHERE history.manga_id = M.id
        AND NOT EXISTS (
            SELECT 0 FROM excluded_scanlator
            WHERE excluded_scanlator.manga_id = M.id
            AND excluded_scanlator.scanlator = chapter.remote_scanlator
        )
    )
    ELSE (SELECT max(history.read_at) FROM history WHERE history.manga_id = M.id)
    END AS lastRead,
    coalesce(C.bookmarkCount, 0) AS bookmarkCount,
    -- KMK -->
    coalesce(C.bookmarkReadCount, 0) AS bookmarkedReadCount,
    -- KMK <--
    coalesce(MC.categories, '0') AS categories
FROM manga M
LEFT JOIN (
    SELECT
        chapter.manga_id,
        count(*) AS total,
        sum(user_read) AS readCount,
        max(chapter.remote_date_upload) AS latestUpload,
        max(chapter.state_date_fetch) AS fetchedAt,
        sum(user_bookmark) AS bookmarkCount,
        -- KMK -->
        sum(CASE WHEN user_bookmark = 1 AND user_read = 1 THEN 1 ELSE 0 END) AS bookmarkReadCount,
        -- KMK <--
        excluded_scanlator.scanlator AS ex_scanlator
    FROM chapter
    LEFT JOIN excluded_scanlator
    ON chapter.manga_id = excluded_scanlator.manga_id
    AND chapter.remote_scanlator = excluded_scanlator.scanlator
    WHERE ex_scanlator IS NULL
    GROUP BY chapter.manga_id
) AS C
ON M.id = C.manga_id
LEFT JOIN (
    SELECT manga_id, group_concat(category_id) AS categories
    FROM manga_category
    GROUP BY manga_id
) AS MC
ON MC.manga_id = M.id
WHERE M.source_id <> 6969
UNION
SELECT
    M.*,
    coalesce(C.total, 0) AS totalCount,
    coalesce(C.readCount, 0) AS readCount,
    C.latestUpload AS latestUpload,
    C.fetchedAt AS chapterFetchedAt,
    -- KUN -->
    -- Same as the non-merged branch above, but over every manga of the merge group
    CASE WHEN EXISTS (
        SELECT 0 FROM excluded_scanlator
        WHERE excluded_scanlator.manga_id IN (SELECT manga_id FROM merged_entry WHERE merge_id = M.id)
    )
    THEN (
        SELECT max(history.read_at)
        FROM history
        JOIN chapter
        ON chapter.id = history.chapter_id
        WHERE history.manga_id IN (SELECT manga_id FROM merged_entry WHERE merge_id = M.id)
        AND NOT EXISTS (
            SELECT 0 FROM excluded_scanlator
            WHERE excluded_scanlator.manga_id = history.manga_id
            AND excluded_scanlator.scanlator = chapter.remote_scanlator
        )
    )
    ELSE (
        SELECT max(history.read_at)
        FROM history
        WHERE history.manga_id IN (SELECT manga_id FROM merged_entry WHERE merge_id = M.id)
    )
    END AS lastRead,
    -- KUN <--
    coalesce(C.bookmarkCount, 0) AS bookmarkCount,
    -- KMK -->
    coalesce(C.bookmarkReadCount, 0) AS bookmarkedReadCount,
    -- KMK <--
    coalesce(MC.categories, '0') AS categories
FROM manga M
LEFT JOIN(
    -- Only the chapters of merged entries can belong to a merge, and only the ones the merge's sort
    -- mode shows: the same dedupe the chapter list applies, so the counts match what the user sees.
    -- KUN -->
    WITH merged_base AS MATERIALIZED (
        SELECT
            chapter.id,
            chapter.manga_id,
            chapter.remote_chapter_number,
            chapter.remote_date_upload,
            chapter.state_date_fetch,
            chapter.user_read,
            chapter.user_bookmark,
            ME.merge_id,
            ME.chapter_priority,
            MG.chapter_sort_mode AS sort_mode
        FROM chapter
        LEFT JOIN excluded_scanlator
        ON chapter.manga_id = excluded_scanlator.manga_id
        AND chapter.remote_scanlator = excluded_scanlator.scanlator
        JOIN merged_entry AS ME
        ON ME.manga_id = chapter.manga_id
        JOIN merge AS MG
        ON MG.manga_id = ME.merge_id
        WHERE excluded_scanlator.scanlator IS NULL
    )
    -- KUN <--
    SELECT
        base.merge_id,
        count(*) AS total,
        sum(base.user_read) AS readCount,
        max(base.remote_date_upload) AS latestUpload,
        max(base.state_date_fetch) AS fetchedAt,
        sum(base.user_bookmark) AS bookmarkCount,
        -- KMK -->
        sum(CASE WHEN base.user_bookmark = 1 AND base.user_read = 1 THEN 1 ELSE 0 END) AS bookmarkReadCount,
        -- KMK <--
        NULL AS ex_scanlator
    FROM merged_base AS base
    WHERE base.sort_mode = 0
    OR (base.sort_mode = 1 AND (
        base.remote_chapter_number < 0
        OR NOT EXISTS (
            SELECT 1 FROM merged_base AS base2
            WHERE base2.merge_id = base.merge_id
            AND base2.remote_chapter_number = base.remote_chapter_number
            AND base2.manga_id != base.manga_id
            AND (
                base2.chapter_priority < base.chapter_priority
                OR (base2.chapter_priority = base.chapter_priority AND base2.manga_id < base.manga_id)
            )
        )
    ))
    OR (base.sort_mode = 2 AND base.manga_id = (
        SELECT base2.manga_id FROM merged_base AS base2
        WHERE base2.merge_id = base.merge_id
        GROUP BY base2.manga_id
        ORDER BY count(*) DESC, base2.manga_id
        LIMIT 1
    ))
    OR (base.sort_mode = 3 AND base.manga_id = (
        SELECT base2.manga_id FROM merged_base AS base2
        WHERE base2.merge_id = base.merge_id
        AND base2.remote_chapter_number >= 0
        GROUP BY base2.manga_id
        ORDER BY max(base2.remote_chapter_number) DESC, base2.manga_id
        LIMIT 1
    ))
    GROUP BY base.merge_id
) AS C
ON C.merge_id = M.id
LEFT JOIN (
    SELECT manga_id, group_concat(category_id) AS categories
    FROM manga_category
    GROUP BY manga_id
) AS MC
ON MC.manga_id = M.id
WHERE M.source_id = 6969;

CREATE VIEW updatesView AS
-- KUN -->
-- Every chapter a merge holds, with the sort mode its own fake-manga row carries. The merged branch
-- below filters it through the same dedupe the chapter list applies, so the feed shows what the user
-- would see after opening the entry.
WITH merged_base AS MATERIALIZED (
    SELECT
        chapter.id,
        chapter.manga_id,
        chapter.remote_chapter_number,
        chapter.remote_date_upload,
        chapter.state_date_fetch,
        chapter.user_read,
        chapter.user_bookmark,
        chapter.user_last_page_read,
        ME.merge_id,
        ME.chapter_priority,
        MG.chapter_sort_mode AS sort_mode
    FROM chapter
    JOIN merged_entry AS ME
    ON ME.manga_id = chapter.manga_id
    JOIN merge AS MG
    ON MG.manga_id = ME.merge_id
)
-- KUN <--
SELECT
    manga.id AS mangaId,
    manga.remote_title AS mangaTitle,
    chapter.id AS chapterId,
    chapter.remote_name AS chapterName,
    chapter.remote_scanlator AS scanlator,
    chapter.remote_url AS chapterUrl,
    chapter.user_read AS read,
    chapter.user_bookmark AS bookmark,
    chapter.user_bookmark_color AS bookmarkColor,
    chapter.user_last_page_read AS lastPageRead,
    manga.source_id AS sourceId,
    manga.user_favorite_at IS NOT NULL AS favorite,
    manga.remote_cover AS thumbnailUrl,
    manga.state_cover_last_modified AS coverLastModified,
    chapter.remote_date_upload AS dateUpload,
    chapter.state_date_fetch AS dateFetch,
    excluded_scanlator.scanlator AS excludedScanlator,
    -- SY -->
    manga.user_title AS userTitle,
    manga.user_thumbnail_url AS userThumbnailUrl
    -- SY <--
FROM manga JOIN chapter
ON manga.id = chapter.manga_id
LEFT JOIN excluded_scanlator
ON manga.id = excluded_scanlator.manga_id
AND chapter.remote_scanlator = excluded_scanlator.scanlator
WHERE manga.user_favorite_at IS NOT NULL AND manga.source_id <> 6969
AND chapter.state_date_fetch > manga.user_favorite_at
UNION
SELECT
    manga.id AS mangaId,
    manga.remote_title AS mangaTitle,
    chapter.id AS chapterId,
    chapter.remote_name AS chapterName,
    chapter.remote_scanlator AS scanlator,
    chapter.remote_url AS chapterUrl,
    chapter.user_read AS read,
    chapter.user_bookmark AS bookmark,
    chapter.user_bookmark_color AS bookmarkColor,
    chapter.user_last_page_read AS lastPageRead,
    manga.source_id AS sourceId,
    manga.user_favorite_at IS NOT NULL AS favorite,
    manga.remote_cover AS thumbnailUrl,
    manga.state_cover_last_modified AS coverLastModified,
    chapter.remote_date_upload AS dateUpload,
    chapter.state_date_fetch AS dateFetch,
    excluded_scanlator.scanlator AS excludedScanlator,
    -- SY -->
    manga.user_title AS userTitle,
    manga.user_thumbnail_url AS userThumbnailUrl
    -- SY <--
-- KUN -->
-- Every entry the merge holds, not just one of them, deduped by the merge's sort mode.
FROM merged_base AS base
JOIN chapter
ON chapter.id = base.id
JOIN manga
ON manga.id = base.merge_id
-- KUN <--
LEFT JOIN excluded_scanlator
ON manga.id = excluded_scanlator.manga_id
AND chapter.remote_scanlator = excluded_scanlator.scanlator
WHERE manga.user_favorite_at IS NOT NULL AND manga.source_id = 6969
AND chapter.state_date_fetch > manga.user_favorite_at
AND (
    base.sort_mode = 0
    OR (base.sort_mode = 1 AND (
        base.remote_chapter_number < 0
        OR NOT EXISTS (
            SELECT 1 FROM merged_base AS base2
            WHERE base2.merge_id = base.merge_id
            AND base2.remote_chapter_number = base.remote_chapter_number
            AND base2.manga_id != base.manga_id
            AND (
                base2.chapter_priority < base.chapter_priority
                OR (base2.chapter_priority = base.chapter_priority AND base2.manga_id < base.manga_id)
            )
        )
    ))
    OR (base.sort_mode = 2 AND base.manga_id = (
        SELECT base2.manga_id FROM merged_base AS base2
        WHERE base2.merge_id = base.merge_id
        GROUP BY base2.manga_id
        ORDER BY count(*) DESC, base2.manga_id
        LIMIT 1
    ))
    OR (base.sort_mode = 3 AND base.manga_id = (
        SELECT base2.manga_id FROM merged_base AS base2
        WHERE base2.merge_id = base.merge_id
        AND base2.remote_chapter_number >= 0
        GROUP BY base2.manga_id
        ORDER BY max(base2.remote_chapter_number) DESC, base2.manga_id
        LIMIT 1
    ))
)
ORDER BY dateFetch DESC;
