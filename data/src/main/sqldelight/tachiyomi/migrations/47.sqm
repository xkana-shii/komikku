-- KMK <--

-- Entries sharing a source and url are merged into one, since the new table won't hold both. The copies are
-- ranked with the ones in the library first, since that is the entry the user has, then by age. The first
-- one stays, takes each detail it is missing from the first copy that has it, and takes over everything
-- attached to the others.
CREATE TEMP TABLE duplicate_mangas AS
SELECT
    _id,
    first_value(_id) OVER (PARTITION BY source, url ORDER BY favorite DESC, _id ASC) AS keep_id,
    row_number() OVER (PARTITION BY source, url ORDER BY favorite DESC, _id ASC) AS precedence,
    favorite
FROM mangas
WHERE (source, url) IN (
    SELECT source, url
    FROM mangas
    GROUP BY source, url
    HAVING count(*) > 1
);

UPDATE mangas
SET favorite = merged.favorite,
    favorite_modified_at = merged.favorite_modified_at,
    initialized = merged.initialized,
    artist = merged.artist,
    author = merged.author,
    description = merged.description,
    genre = merged.genre,
    thumbnail_url = merged.thumbnail_url,
    status = merged.status,
    viewer = merged.viewer,
    chapter_flags = merged.chapter_flags,
    notes = merged.notes,
    memo = merged.memo,
    last_update = merged.last_update,
    cover_last_modified = merged.cover_last_modified,
    date_added = merged.date_added,
    filtered_scanlators = merged.filtered_scanlators,
    last_modified_at = merged.last_modified_at,
    version = merged.version,
    is_syncing = merged.is_syncing
FROM (
    SELECT DISTINCT
        D.keep_id,
        max(M.favorite) OVER (PARTITION BY D.keep_id) AS favorite,
        coalesce(
            min(nullif(M.favorite_modified_at, 0)) OVER (PARTITION BY D.keep_id),
            min(CASE WHEN M.favorite = 1 THEN nullif(M.date_added, 0) END) OVER (PARTITION BY D.keep_id)
        ) AS favorite_modified_at,
        max(M.initialized) OVER (PARTITION BY D.keep_id) AS initialized,
        first_value(M.artist) OVER (PARTITION BY D.keep_id ORDER BY M.artist IS NULL, D.precedence) AS artist,
        first_value(M.author) OVER (PARTITION BY D.keep_id ORDER BY M.author IS NULL, D.precedence) AS author,
        first_value(M.description) OVER (PARTITION BY D.keep_id ORDER BY M.description IS NULL, D.precedence) AS description,
        first_value(M.genre) OVER (PARTITION BY D.keep_id ORDER BY M.genre IS NULL, D.precedence) AS genre,
        first_value(M.thumbnail_url) OVER (PARTITION BY D.keep_id ORDER BY M.thumbnail_url IS NULL, D.precedence) AS thumbnail_url,
        first_value(M.status) OVER (PARTITION BY D.keep_id ORDER BY M.status = 0, D.precedence) AS status,
        first_value(M.viewer) OVER (PARTITION BY D.keep_id ORDER BY M.viewer = 0, D.precedence) AS viewer,
        first_value(M.chapter_flags) OVER (PARTITION BY D.keep_id ORDER BY M.chapter_flags = 0, D.precedence) AS chapter_flags,
        first_value(M.notes) OVER (PARTITION BY D.keep_id ORDER BY M.notes = '', D.precedence) AS notes,
        first_value(M.memo) OVER (PARTITION BY D.keep_id ORDER BY M.memo = '{}', D.precedence) AS memo,
        max(M.last_update) OVER (PARTITION BY D.keep_id) AS last_update,
        max(M.cover_last_modified) OVER (PARTITION BY D.keep_id) AS cover_last_modified,
        coalesce(min(nullif(M.date_added, 0)) OVER (PARTITION BY D.keep_id), 0) AS date_added,
        first_value(M.filtered_scanlators) OVER (PARTITION BY D.keep_id ORDER BY M.filtered_scanlators IS NULL, D.precedence) AS filtered_scanlators,
        max(M.last_modified_at) OVER (PARTITION BY D.keep_id) AS last_modified_at,
        max(M.version) OVER (PARTITION BY D.keep_id) AS version,
        max(M.is_syncing) OVER (PARTITION BY D.keep_id) AS is_syncing
    FROM duplicate_mangas D
    JOIN mangas M
    ON M._id = D._id
) AS merged
WHERE mangas._id = merged.keep_id;

-- KMK -->
-- Forward Komikku-owned child rows to the surviving manga before the old table is removed.
UPDATE merged
SET manga_id = (SELECT keep_id FROM duplicate_mangas WHERE _id = merged.manga_id)
WHERE manga_id IN (SELECT _id FROM duplicate_mangas WHERE _id != keep_id);

UPDATE merged
SET merge_id = (SELECT keep_id FROM duplicate_mangas WHERE _id = merged.merge_id)
WHERE merge_id IN (SELECT _id FROM duplicate_mangas WHERE _id != keep_id);

UPDATE search_titles
SET manga_id = (SELECT keep_id FROM duplicate_mangas WHERE _id = search_titles.manga_id)
WHERE manga_id IN (SELECT _id FROM duplicate_mangas WHERE _id != keep_id);

UPDATE search_tags
SET manga_id = (SELECT keep_id FROM duplicate_mangas WHERE _id = search_tags.manga_id)
WHERE manga_id IN (SELECT _id FROM duplicate_mangas WHERE _id != keep_id);

CREATE TEMP TABLE merged_search_metadata AS
SELECT DISTINCT
    D.keep_id AS manga_id,
    first_value(S.uploader) OVER (PARTITION BY D.keep_id ORDER BY D.favorite DESC, D.precedence) AS uploader,
    first_value(S.extra) OVER (PARTITION BY D.keep_id ORDER BY D.favorite DESC, D.precedence) AS extra,
    first_value(S.indexed_extra) OVER (PARTITION BY D.keep_id ORDER BY D.favorite DESC, D.precedence) AS indexed_extra,
    max(S.extra_version) OVER (PARTITION BY D.keep_id) AS extra_version
FROM duplicate_mangas D
JOIN search_metadata S ON S.manga_id = D._id;

DELETE FROM search_metadata
WHERE manga_id IN (SELECT _id FROM duplicate_mangas);

INSERT INTO search_metadata(manga_id, uploader, extra, indexed_extra, extra_version)
SELECT manga_id, uploader, extra, indexed_extra, extra_version
FROM merged_search_metadata;

DROP TABLE merged_search_metadata;

CREATE TEMP TABLE merged_update_errors AS
SELECT DISTINCT
    D.keep_id AS manga_id,
    first_value(LUE.message_id) OVER (PARTITION BY D.keep_id ORDER BY LUE.last_update DESC) AS message_id,
    max(LUE.last_update) OVER (PARTITION BY D.keep_id) AS last_update
FROM duplicate_mangas D
JOIN libraryUpdateError LUE ON LUE.manga_id = D._id;

DELETE FROM libraryUpdateError
WHERE manga_id IN (SELECT _id FROM duplicate_mangas);

INSERT INTO libraryUpdateError(manga_id, message_id, last_update)
SELECT manga_id, message_id, last_update
FROM merged_update_errors;

DROP TABLE merged_update_errors;

-- KMK <--

-- Every child table is rebuilt further down and resolves the surviving entry there, so nothing
-- else has to be rewritten here first.
DELETE FROM mangas
WHERE _id IN (SELECT _id FROM duplicate_mangas WHERE _id != keep_id);

CREATE TABLE manga(
    id INTEGER NOT NULL PRIMARY KEY,
    source_id INTEGER NOT NULL,
    remote_url TEXT NOT NULL,
    remote_artist TEXT,
    remote_author TEXT,
    remote_description TEXT,
    remote_genre TEXT AS List<String>,
    remote_title TEXT NOT NULL,
    remote_status INTEGER NOT NULL,
    remote_cover TEXT,
    user_favorite_at INTEGER,
    state_chapter_last_update INTEGER,
    state_chapter_next_update INTEGER,
    state_initialized INTEGER AS Boolean NOT NULL,
    user_reader_flags INTEGER NOT NULL,
    user_chapter_flags INTEGER NOT NULL,
    state_cover_last_modified INTEGER NOT NULL,
    -- KMK -->
    state_date_added INTEGER NOT NULL,
    user_filtered_scanlators TEXT,
    -- KMK <--
    remote_update_strategy INTEGER AS UpdateStrategy NOT NULL DEFAULT 0,
    state_chapter_fetch_interval INTEGER DEFAULT 0 NOT NULL,
    -- KMK -->
    state_last_modified_at INTEGER NOT NULL DEFAULT 0,
    state_version INTEGER NOT NULL DEFAULT 0,
    state_is_syncing INTEGER NOT NULL DEFAULT 0,
    -- KMK <--
    user_notes TEXT NOT NULL DEFAULT "",
    remote_memo BLOB AS JsonObject NOT NULL DEFAULT (CAST('{}' AS BLOB)),
    UNIQUE(source_id, remote_url)
);

INSERT INTO manga(
    id, source_id, remote_url, remote_artist, remote_author, remote_description, remote_genre, remote_title,
    remote_status, remote_cover, user_favorite_at, state_chapter_last_update, state_chapter_next_update,
    state_initialized, user_reader_flags, user_chapter_flags, state_cover_last_modified, state_date_added,
    user_filtered_scanlators, remote_update_strategy, state_chapter_fetch_interval, state_last_modified_at,
    state_version, state_is_syncing, user_notes, remote_memo
)
SELECT
    _id, source, url, artist, author, description, genre, title,
    status, thumbnail_url,
    CASE WHEN favorite = 1 THEN coalesce(favorite_modified_at, nullif(date_added, 0), 0) ELSE NULL END,
    last_update, next_update, initialized, viewer, chapter_flags, cover_last_modified, date_added,
    filtered_scanlators, update_strategy, calculate_interval, last_modified_at, version, is_syncing, notes, memo
FROM mangas;

DROP TABLE mangas;

CREATE INDEX manga_user_favorite_at_index ON manga(user_favorite_at) WHERE user_favorite_at IS NOT NULL;

-- KMK -->
CREATE TRIGGER update_last_modified_at_mangas
AFTER UPDATE ON manga
FOR EACH ROW
BEGIN
  UPDATE manga
  SET state_last_modified_at = strftime('%s', 'now')
  WHERE id = new.id;
END;

CREATE TRIGGER update_manga_version AFTER UPDATE ON manga
BEGIN
    UPDATE manga SET state_version = state_version + 1
    WHERE id = new.id AND new.state_is_syncing = 0 AND (
        new.remote_url != old.remote_url OR
        new.remote_description != old.remote_description OR
        new.user_favorite_at IS NOT old.user_favorite_at
    );
END;
