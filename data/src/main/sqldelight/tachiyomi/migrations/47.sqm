-- SY -->
-- SyncYomi protocol v2 needs a stable per-category identity (uid) plus the usual sync bookkeeping,
-- so categories can be merged and tombstoned across devices.
ALTER TABLE categories ADD COLUMN version INTEGER NOT NULL DEFAULT 0;
ALTER TABLE categories ADD COLUMN uid INTEGER NOT NULL DEFAULT 0;
ALTER TABLE categories ADD COLUMN last_modified_at INTEGER NOT NULL DEFAULT 0;
ALTER TABLE categories ADD COLUMN is_syncing INTEGER NOT NULL DEFAULT 0;

UPDATE categories SET uid = abs(random());

DROP TRIGGER IF EXISTS insert_category_uid;
CREATE TRIGGER insert_category_uid AFTER INSERT ON categories
BEGIN
    UPDATE categories
    SET uid = CASE WHEN uid = 0 THEN abs(random()) ELSE uid END,
        last_modified_at = CASE WHEN last_modified_at = 0 THEN strftime('%s', 'now') ELSE last_modified_at END
    WHERE _id = new._id;
END;

DROP TRIGGER IF EXISTS update_category_version;
CREATE TRIGGER update_category_version AFTER UPDATE ON categories
WHEN new.is_syncing = 0 AND (
    new.name != old.name OR
    new.sort != old.sort OR
    new.flags != old.flags
    -- KUN -->
    OR new.hidden != old.hidden
    -- KUN <--
)
BEGIN
    UPDATE categories
    SET version = version + 1,
        last_modified_at = strftime('%s', 'now')
    WHERE _id = new._id;
END;

-- Chapters are versioned and merged separately in sync protocol v2; bumping the manga version per
-- chapter read let the device that read more chapters win all manga-level merges.
DROP TRIGGER IF EXISTS update_chapter_and_manga_version;
CREATE TRIGGER update_chapter_and_manga_version AFTER UPDATE ON chapters
WHEN new.is_syncing = 0 AND (
    new.read != old.read OR
    new.bookmark != old.bookmark OR
    new.last_page_read != old.last_page_read
)
BEGIN
    UPDATE chapters SET version = version + 1
    WHERE _id = new._id;
END;

-- removing a manga from a category is a manga-level change and must bump its version
-- (mangas_categories.last_modified_at and its trigger already come from migration 28)
CREATE TRIGGER IF NOT EXISTS delete_manga_category_update_version AFTER DELETE ON mangas_categories
BEGIN
    UPDATE mangas
    SET version = version + 1
    WHERE _id = old.manga_id AND (SELECT is_syncing FROM mangas WHERE _id = old.manga_id) = 0;
END;

-- Sync restores (is_syncing = 1) and the flag reset afterwards (old.is_syncing = 1) must not stamp
-- last_modified_at, or every restored row is uploaded straight back by the next delta.
DROP TRIGGER IF EXISTS update_last_modified_at_mangas;
CREATE TRIGGER update_last_modified_at_mangas
AFTER UPDATE ON mangas
FOR EACH ROW
WHEN new.is_syncing = 0 AND old.is_syncing = 0
BEGIN
  UPDATE mangas
  SET last_modified_at = strftime('%s', 'now')
  WHERE _id = new._id;
END;

DROP TRIGGER IF EXISTS update_last_modified_at_chapters;
CREATE TRIGGER update_last_modified_at_chapters
AFTER UPDATE ON chapters
FOR EACH ROW
WHEN new.is_syncing = 0 AND old.is_syncing = 0
BEGIN
  UPDATE chapters
  SET last_modified_at = strftime('%s', 'now')
  WHERE _id = new._id;
END;
-- SY <--
