CREATE VIEW historyView AS
SELECT
    history.id AS id,
    manga.id AS mangaId,
    chapter.id AS chapterId,
    manga.remote_title AS title,
    manga.remote_cover AS thumbnailUrl,
    manga.source_id AS sourceId,
    manga.user_favorite_at IS NOT NULL AS favorite,
    manga.state_cover_last_modified AS coverLastModified,
    chapter.remote_chapter_number AS chapterNumber,
    -- KMK -->
    manga.user_chapter_flags AS chapterFlags,
    chapter.user_read AS read,
    chapter.user_last_page_read AS lastPageRead,
    coalesce(C.total, 0) AS totalCount,
    coalesce(C.readCount, 0) AS readCount,
    coalesce(C.bookmarkCount, 0) AS bookmarkCount,
    coalesce(C.bookmarkReadCount, 0) AS bookmarkReadCount,
    -- KMK <--
    history.read_at AS readAt,
    history.read_duration AS readDuration,
    max_read.read_at AS maxReadAt,
    max_read.chapter_id AS maxReadAtChapterId,
    -- SY -->
    manga.user_title AS userTitle,
    manga.user_thumbnail_url AS userThumbnailUrl
    -- SY <--
FROM manga
JOIN chapter
ON manga.id = chapter.manga_id
JOIN history
ON chapter.id = history.chapter_id
JOIN (
    SELECT manga_id, chapter_id, MAX(read_at) AS read_at
    FROM history
    GROUP BY manga_id
) AS max_read
ON chapter.manga_id = max_read.manga_id
-- KMK -->
LEFT JOIN(
    SELECT
        chapter.manga_id,
        count(*) AS total,
        sum(user_read) AS readCount,
        sum(user_bookmark) AS bookmarkCount,
        sum(CASE WHEN user_bookmark = 1 AND user_read = 1 THEN 1 ELSE 0 END) AS bookmarkReadCount,
        excluded_scanlator.scanlator AS ex_scanlator
    FROM chapter
    LEFT JOIN excluded_scanlator
    ON chapter.manga_id = excluded_scanlator.manga_id
    AND chapter.remote_scanlator = excluded_scanlator.scanlator
    WHERE ex_scanlator IS NULL
    GROUP BY chapter.manga_id
) AS C
ON manga.id = C.manga_id;
-- KMK <--

history:
SELECT
id,
mangaId,
chapterId,
title,
thumbnailUrl,
sourceId,
favorite,
coverLastModified,
chapterNumber,
-- KMK -->
read,
lastPageRead,
CASE
    WHEN (chapterFlags & :bookmarkUnmask) != 0 THEN totalCount - bookmarkCount
    WHEN (chapterFlags & :bookmarkMask) != 0 THEN bookmarkCount
    ELSE totalCount
END AS totalCountCalculated,
CASE
    WHEN (chapterFlags & :bookmarkUnmask) != 0 THEN readCount - bookmarkReadCount
    WHEN (chapterFlags & :bookmarkMask) != 0 THEN bookmarkReadCount
    ELSE readCount
END AS readCountCalculated,
-- KMK <--
readAt,
readDuration,
-- SY -->
userTitle,
userThumbnailUrl
-- SY <--
FROM historyView
WHERE historyView.readAt IS NOT NULL
-- KMK -->
AND (
    :unfinishedManga IS NULL
    OR (:unfinishedManga = 1 AND totalCountCalculated > readCountCalculated)
    OR (:unfinishedManga = 0 AND totalCountCalculated <= readCountCalculated)
)
AND (:unfinishedChapter IS NULL OR read != :unfinishedChapter)
AND (:nonLibraryEntries IS NULL OR favorite != :nonLibraryEntries)
-- KMK <--
AND maxReadAtChapterId = historyView.chapterId
AND lower(historyView.title) LIKE ('%' || :query || '%')
ORDER BY readAt DESC;

getLatestHistory:
SELECT
history.id AS id,
manga.id AS mangaId,
chapter.id AS chapterId,
manga.remote_title AS title,
manga.remote_cover AS thumbnailUrl,
manga.source_id AS sourceId,
manga.user_favorite_at IS NOT NULL AS favorite,
manga.state_cover_last_modified AS coverLastModified,
chapter.remote_chapter_number AS chapterNumber,
-- KMK -->
chapter.user_read AS read,
chapter.user_last_page_read AS lastPageRead,
(
    SELECT
        CASE
            WHEN (manga.user_chapter_flags & :bookmarkUnmask) != 0 THEN count(*) - coalesce(sum(C.user_bookmark), 0)
            WHEN (manga.user_chapter_flags & :bookmarkMask) != 0 THEN coalesce(sum(C.user_bookmark), 0)
            ELSE count(*)
        END
    FROM chapter C
    WHERE C.manga_id = manga.id
    AND NOT EXISTS (
        SELECT 1 FROM excluded_scanlator ES
        WHERE ES.manga_id = C.manga_id
        AND ES.scanlator = C.remote_scanlator
    )
) AS totalCount,
(
    SELECT
        CASE
            WHEN (manga.user_chapter_flags & :bookmarkUnmask) != 0 THEN coalesce(sum(C.user_read), 0) - coalesce(sum(CASE WHEN C.user_bookmark = 1 AND C.user_read = 1 THEN 1 ELSE 0 END), 0)
            WHEN (manga.user_chapter_flags & :bookmarkMask) != 0 THEN coalesce(sum(CASE WHEN C.user_bookmark = 1 AND C.user_read = 1 THEN 1 ELSE 0 END), 0)
            ELSE coalesce(sum(C.user_read), 0)
        END
    FROM chapter C
    WHERE C.manga_id = manga.id
    AND NOT EXISTS (
        SELECT 1 FROM excluded_scanlator ES
        WHERE ES.manga_id = C.manga_id
        AND ES.scanlator = C.remote_scanlator
    )
) AS readCount,
-- KMK <--
history.read_at AS readAt,
history.read_duration AS readDuration,
-- SY -->
manga.user_title AS userTitle,
manga.user_thumbnail_url AS userThumbnailUrl
-- SY <--
FROM history
JOIN manga
ON manga.id = history.manga_id
JOIN chapter
ON chapter.id = history.chapter_id
WHERE history.read_at IS NOT NULL
ORDER BY history.read_at DESC
LIMIT 1;
